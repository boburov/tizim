// Admin panel ma'lumotlar bazasi (PostgreSQL orqali Prisma).
// Bu baza faqat provisioning metadata'sini saqlaydi. Har tenant esa
// o'z alohida MongoDB bazasida ishlaydi (tenant server mongoose'da).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 2-darajali admin userlar. Super admin .env orqali (statik) kiradi,
// bu jadval keyinchalik qo'shiladigan userlar uchun (role bilan).
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

// Tenant hayot sikli
enum TenantStatus {
  DRAFT // yozuv yaratildi, hali provision qilinmagan
  PROVISIONING // provision.sh ishlayapti
  ACTIVE // ishga tushdi
  FAILED // provisioning xatosi
  SUSPENDED // to'xtatilgan (limit oshgan yoki to'lov yo'q)
  DEPROVISIONING // deprovision.sh ishlayapti
  DELETED // VPS resurslari o'chirilgan, yozuv arxiv sifatida qoldi
}

// Tenant kodining GitHub repodagi holati.
enum GitStatus {
  DISABLED // GitHub integratsiyasi o'chiq (token yo'q yoki tenant uchun o'chirilgan)
  PENDING // repo hali yaratilmagan
  CREATING // GitHub API'da repo ochilyapti
  PUSHING // VPS'dan kod yuborilyapti
  SYNCED // repo bor va oxirgi push muvaffaqiyatli
  FAILED // repo yaratish yoki push xatosi
}

// Sozlama o'zgarishini tenantga yetkazish holati.
enum ApplyStatus {
  IDLE // kutilayotgan o'zgarish yo'q
  PENDING // o'zgarish saqlangan, hali qo'llanmagan
  APPLYING // reconfigure.sh ishlayapti
  FAILED // qo'llashda xato
}

// "Tizim" turi — dinamik. Hozircha "oquv markaz", keyin boshqalar qo'shiladi.
// Har template qaysi client/server shablonidan nusxa olinishini belgilaydi.
model SystemTemplate {
  id          String   @id @default(cuid())
  key         String   @unique // masalan "study-center"
  name        String // ko'rinadigan nom, masalan "O'quv markaz tizimi"
  description String?
  // Provisioning skript template papkalari (VPS'dagi manba yo'llari)
  templateDir String   @default("/root/templates/study-center")
  // Bu tizim faol tanlash uchun ochiqmi
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants Tenant[]
}

model Tenant {
  id String @id @default(cuid())

  // Foydalanuvchi kiritadigan brend ma'lumotlari.
  //
  // Ranglar HEX ko'rinishida saqlanadi (rang tanlagich shu formatda ishlaydi),
  // client .env ga yozishdan oldin HSL kanallariga aylantiriladi — tenant
  // client `parseHsl` faqat "33 33% 35%" formatini o'qiydi.
  name       String // markaz nomi (VITE_APP_NAME)
  domain     String  @unique // masalan markaz.example.uz
  brandColor String  @default("#4f46e5") // VITE_APP_PRIMARY (light)
  logoUrl    String? // VITE_APP_LOGO
  botToken   String? // TELEGRAM_BOT_TOKEN (shifrlangan holda saqlanadi)

  // Qolgan brend ranglari — ixtiyoriy. Berilmasa tenant client ularni
  // brandColor'dan avtomatik hosil qiladi (tus saqlanadi, kontrast ta'minlanadi).
  brandBackground     String? // VITE_APP_BACKGROUND
  brandColorDark      String? // VITE_APP_PRIMARY_DARK
  brandBackgroundDark String? // VITE_APP_BACKGROUND_DARK

  // NOYOB DB nomi — hech qachon takrorlanmaydi (slug + qisqa cuid).
  // Bu tenant MongoDB bazasining nomi bo'ladi.
  dbName String @unique

  // Ajratilgan PM2 process nomi va port
  pm2Name String @unique
  port    Int    @unique

  // ── VPS ──
  //
  // Tenant QAYSI SERVERDA turadi. `Vps` yozuvi SSH ulanish ma'lumotini
  // (shifrlangan kalit bilan) va deploy katalogini saqlaydi; provisioning
  // skriptlari `vps.isLocal` bo'lsa lokal `spawn`, aks holda SSH orqali
  // ishlaydi (`provisioning/script-runner.ts`).
  //
  // ⚠ IXTIYORIY (nullable) — sabab MIGRATSIYA: ustun qo'shilganda mavjud
  // tenantlar `vps_local` yozuviga bog'lanadi (migration.sql da), lekin
  // sxema darajasida `null` ruxsat etiladi — DRAFT tenant hali VPS
  // tanlanmagan bo'lishi mumkin.
  vps   Vps?    @relation(fields: [vpsId], references: [id])
  vpsId String?

  // DNS uchun beriladigan IP.
  //
  // ⚠ ESKIRGAN — `vps.host` shu ma'lumotning YAGONA manbai. Ustun hozircha
  // qoladi: `tenant-dsn.ts`, `tenant-refresh.service.ts` va
  // `customers.service.ts` uni o'qiydi. 3-fazada ular `vps.host` ga
  // o'tkaziladi va ustun olib tashlanadi. Yangi kod bu maydonga YOZMASIN.
  serverIp String?

  status        TenantStatus @default(DRAFT)
  provisionLog  String?      @db.Text // provision.sh chiqishi (oxirgi)
  failureReason String?

  // ─────────────────────── FILIALLAR: loyiha darajasidagi konfiguratsiya
  //
  // Bu YAGONA manba. Tenant serverga ikki yo'l bilan yetadi:
  //   1) `.env` (BRANCHES_ENABLED / BRANCH_LIMIT) — provision/reconfigure
  //      paytida yoziladi, ya'ni tenant BIRINCHI heartbeat'dan OLDIN ham
  //      to'g'ri chegara bilan ko'tariladi;
  //   2) heartbeat javobi (`max_branches`) — tirik yangilanish, restart
  //      talab qilmaydi.
  //
  // ⚠ MIJOZ BU MAYDONLARNI O'ZGARTIRA OLMAYDI. Ular faqat Developer Admin
  // (admin panel, SUPER_ADMIN/ADMIN) orqali yoziladi; tenant ilova ularni
  // FAQAT O'QIYDI.

  // false = yakka markaz (aynan bitta filial), true = ko'p filialli.
  branchesEnabled Boolean @default(true)

  // Developer Admin qo'lda qo'ygan chegara.
  //
  // null = "meros" — tarifdagi `max_branches`, u ham bo'lmasa tizim
  // standarti (DEFAULT_BRANCH_LIMIT). Ataylab nullable: standart
  // o'zgarsa, uni qo'lda o'zgartirmagan barcha loyihalar yangisini
  // AVTOMATIK oladi — bu `TenantSetting` bilan bir xil qoida.
  //
  // -1 = cheksiz. Sotib olingan qo'shimcha filiallar bu songa QO'SHILADI
  // (`Addon` -> `TenantAddon`, feature kaliti `max_branches`).
  branchLimitOverride Int?

  // Deprovision (o'chirish) kuzatuvi
  deprovisionLog String?   @db.Text
  deletedAt      DateTime?

  // --- To'xtatish (suspend) kuzatuvi ---
  // Obuna tugaganda pm2 process to'xtatiladi va status SUSPENDED bo'ladi.
  // Papka, baza va yuklangan fayllar TEGILMAYDI — to'lov kelishi bilan
  // `resume` bir soniyada hammasini qaytaradi.
  suspendedAt   DateTime?
  suspendReason String?
  suspendLog    String?   @db.Text

  // Tenant server bilan aloqa (heartbeat) — noyob sirli kalit
  heartbeatSecret String?   @unique
  lastHeartbeatAt DateTime?

  // --- GitHub: har tenant kodi o'z repositoriysida ---
  gitStatus    GitStatus @default(PENDING)
  repoFullName String?   @unique // "owner/tenant-bilim-a3f9c210"
  repoUrl      String? // https://github.com/owner/repo
  repoPrivate  Boolean   @default(true)
  repoError    String?
  gitLog       String?   @db.Text // oxirgi push chiqishi
  lastPushedAt DateTime?

  // Tenant repodagi GitHub Action shu token bilan admin serverga murojaat
  // qiladi va o'zini qayta deploy qildiradi. VPS SSH kaliti repolarga
  // TARQATILMAYDI — bitta repo sizib chiqsa ham faqat SHU tenant zarar ko'radi.
  deployToken String? @unique

  // --- Sozlamalar (.env) boshqaruvi ---
  settings TenantSetting[]

  // Oxirgi MUVAFFAQIYATLI qo'llangan konfiguratsiya surati.
  // Kutilayotgan o'zgarish = hozirgi hisoblangan konfiguratsiya bilan farq.
  // Maxfiy qiymatlar bu yerda ochiq emas — sha256 hash sifatida yoziladi,
  // shunda "o'zgardimi" savoliga javob bor, sir esa ikki joyda yotmaydi.
  appliedConfig Json?
  applyStatus   ApplyStatus @default(IDLE)
  applyLog      String?     @db.Text
  applyError    String?
  lastAppliedAt DateTime?

  systemTemplate   SystemTemplate @relation(fields: [systemTemplateId], references: [id])
  systemTemplateId String

  // Self-service: bu tenant qaysi mijozga tegishli (super admin yaratsa null)
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  subscription   Subscription?
  usageSnapshots UsageSnapshot[]
  addons         TenantAddon[]
  apiConsumers   ApiConsumer[]
  bots           Bot[]

  // Modul o'chirgichlari — tarifdan USTUN turadigan loyihaviy qaror.
  featureOverrides TenantFeatureOverride[]

  // Deploy jurnali — har provision/apply/suspend/migrate bitta yozuv.
  deployments Deployment[]

  // Tijorat konfiguratsiyasi o'zgarishlari tarixi (kim, qachon, nega).
  commercialChanges TenantCommercialChange[]

  createdBy String? // qaysi admin yaratdi (email)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([vpsId])
}

// ═══════════════════════════════════════════════════════════════════════════
// VPS — TENANTLAR JOYLASHADIGAN SERVER
// ═══════════════════════════════════════════════════════════════════════════
//
// Ilgari bitta VPS edi va u admin_server bilan bir mashinada turardi —
// provisioning lokal `spawn('bash')` bilan ishlardi, `Tenant.serverIp`
// esa faqat DNS ko'rsatish uchun edi. Bu model VPS'ni haqiqiy obyekt
// qiladi: bir nechta server, har birida o'z tenantlari.
//
// ── SIRLAR ──
// `sshPrivateKey` va `sshPassword` — AES-256-GCM (`common/crypto/
// secrets.util.ts`, `SETTINGS_ENCRYPTION_KEY`). API hech qachon ochiq
// qiymatni QAYTARMAYDI: ro'yxat/tafsilotda faqat `sshKeyFingerprint`
// va "kalit bor/yo'q" bayrog'i. Yangilashda yangi kalit YUBORILADI,
// eskisi o'qilmaydi.
//
// ── `isLocal` ──
// admin_server'ning o'zi turgan mashina. Unda SSH kerak emas — skriptlar
// hozirgidek lokal ishlaydi. Migratsiya mavjud tenantlarni shu yozuvga
// bog'laydi, shunda xatti-harakat o'zgarmaydi.

enum VpsAuthMethod {
  SSH_KEY
  PASSWORD
}

enum VpsStatus {
  UNKNOWN // hali tekshirilmagan
  ONLINE // oxirgi test o'tdi
  OFFLINE // ulanib bo'lmadi
  ERROR // ulandi, lekin talab bajarilmadi (masalan pm2 yo'q)
}

model Vps {
  id String @id @default(cuid())

  name String // "Hetzner-1", "Asosiy"
  host String // IP yoki domen — DNS ham shundan
  sshPort Int @default(22)
  sshUser String @default("root")

  authMethod    VpsAuthMethod @default(SSH_KEY)
  sshPrivateKey String?       @db.Text // shifrlangan
  sshPassword   String? // shifrlangan
  // Ochiq kalitning barmoq izi — UI'da "qaysi kalit" ni ko'rsatish uchun,
  // sirni ochmasdan.
  sshKeyFingerprint String?

  // Deploy ildizi. provision.sh shu yerdan `tenants/<dbName>` va
  // `admin` yo'llarini hisoblaydi.
  rootDir String @default("/root")

  // Shu VPS'dagi Postgres bazaviy URL'i (parolsiz DB nomi bilan tugaydi:
  // `postgresql://user:pass@127.0.0.1:5432`). Skriptlar bazani SHU
  // yerda yaratadi; admin_server esa unga SSH TUNNEL orqali ulanadi
  // (`tenant-db.service.ts`) — Postgres tashqariga ochilmaydi.
  // `null` = standart (`postgresql://postgres:postgres@127.0.0.1:5432`).
  // Parol bor — SHIFRLANGAN saqlanadi.
  postgresBaseUrl String?

  // admin_server shu mashinada — SSH'siz lokal bajarish.
  isLocal Boolean @default(false)

  status         VpsStatus @default(UNKNOWN)
  lastCheckedAt  DateTime?
  lastCheckError String?
  lastCheckLog   String?   @db.Text
  // Oxirgi testdagi resurslar: { cpu, memTotalMb, memFreeMb, diskTotalGb,
  // diskFreeGb, load1, tools: { node, pm2, nginx, psql, certbot } }
  resources Json?

  // O'chirish o'rniga deaktivatsiya: tenantlari bor VPS o'chirilmaydi.
  isActive   Boolean @default(true)
  // Ixtiyoriy sig'im — tenant tayinlashda tekshiriladi, null = cheksiz.
  maxTenants Int?
  notes      String?

  tenants     Tenant[]
  deployments Deployment[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════════════════════
// DEPLOYMENT — HAR BIR INFRATUZILMA AMALINING JURNALI
// ═══════════════════════════════════════════════════════════════════════════
//
// Ilgari log `Tenant.provisionLog/applyLog/suspendLog` ustunlarida — faqat
// OXIRGISI qolardi va jarayon tugaguncha panel hech narsa ko'rmasdi. Endi
// har amal alohida yozuv: tirik log (skript ishlayotganda to'ldiriladi),
// kim boshlagan, qaysi VPS'da, qanday tugagan. Eski ustunlar moslik uchun
// hozircha yozilaveradi.
//
// `meta` — amalga xos ma'lumot; MIGRATE uchun `{ sourceVpsId, targetVpsId,
// step, dumpPath, ... }`.

enum DeploymentKind {
  PROVISION
  RESTART
  REBUILD
  DEPLOY // kod repodan tortiladi + rebuild
  PUSH // faqat GitHub'ga
  SUSPEND
  RESUME
  DEPROVISION
  MIGRATE // boshqa VPS'ga ko'chirish
  STOP_SOURCE // migratsiyadan keyin eski VPS'da pm2 stop
  DECOMMISSION_SOURCE // migratsiyadan keyin eski VPS'da deprovision
  BOOTSTRAP_VPS // skript/shablon sinxron
}

enum DeploymentStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Deployment {
  id String @id @default(cuid())

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  vps   Vps?    @relation(fields: [vpsId], references: [id], onDelete: SetNull)
  vpsId String?

  kind   DeploymentKind
  status DeploymentStatus @default(RUNNING)

  // Tirik log — jarayon davomida ~1 soniyada bir yangilanadi, oxirgi
  // 60 KB saqlanadi (LOG_LIMIT).
  log      String  @default("") @db.Text
  exitCode Int?
  error    String?
  meta     Json?

  startedBy  String? // admin email
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([tenantId, startedAt])
  @@index([status])
}

// Tenantning .env sozlamasi — FAQAT standartdan farq qiladigan qiymatlar.
//
// Sozlamalar ro'yxati (kalit, tur, standart qiymat, validatsiya, qo'llash
// rejimi) admin_server kodidagi registrda turadi: `settings/settings.registry.ts`.
// Bu yerda faqat mijoz o'zgartirgan qiymat saqlanadi — shunda registrda
// standart qiymat yangilansa, uni o'zgartirmagan barcha tenantlar yangisini
// avtomatik oladi.
model TenantSetting {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  key      String // registrdagi kalit, masalan "GEMINI_API_KEY"

  // Maxfiy sozlama (`secret` turi) shifrlangan holda yotadi: "v1:iv:tag:data".
  // Ochiq sozlama shundayligicha. Farqni `isSecret` bildiradi.
  value    String  @db.Text
  isSecret Boolean @default(false)

  updatedBy String? // qaysi admin o'zgartirdi (email)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String?
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============================================================================
// SELF-SERVICE: mijozlar (AdminUser'dan ALOHIDA — bular to'lov qiladigan
// tashqi foydalanuvchilar, AdminUser esa bizning xodimlarimiz).
// ============================================================================

model Customer {
  id String @id @default(cuid())

  email        String  @unique
  // Google orqali kirgan mijozda parol YO'Q — shuning uchun optional.
  // Parol bilan kirishga urinishda null bo'lsa rad etiladi.
  passwordHash String?
  fullName     String?
  phone        String?
  companyName  String?

  // --- Google OAuth ---
  // googleId bo'lsa — bu hisob Google bilan bog'langan.
  googleId  String? @unique
  avatarUrl String?

  emailVerified Boolean   @default(false)
  verifyToken   String?   @unique // email tasdiqlash tokeni
  resetToken    String?   @unique // parol tiklash tokeni
  resetTokenExp DateTime?

  isActive Boolean @default(true)

  tenants       Tenant[]
  subscriptions Subscription[]
  transactions  Transaction[]
  apiConsumers  ApiConsumer[]
  bots          Bot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// TARIFLAR VA IMKONIYATLAR (entitlements)
// ============================================================================

enum BillingCycle {
  MONTHLY
  YEARLY
  LIFETIME
}

// Feature ikki xil bo'ladi:
//   LIMIT   — raqamli chek (masalan max_users = 1000)
//   BOOLEAN — yoqilgan/o'chirilgan (masalan telegram_bot)
enum FeatureType {
  LIMIT
  BOOLEAN
}

// Dinamik imkoniyatlar ro'yxati. Yangi xizmat qo'shilsa (Telegram bot, SMS)
// shu yerga yangi yozuv qo'shiladi — kod o'zgartirilmaydi.
model Feature {
  id          String      @id @default(cuid())
  key         String      @unique // "max_users", "telegram_bot", "max_storage_mb"
  name        String
  description String?
  type        FeatureType @default(LIMIT)
  unit        String? // "ta", "MB" — UI da ko'rsatish uchun
  // Bu feature usage orqali kuzatiladimi (heartbeat metrikasi bilan bog'liqmi)
  metricKey   String? // masalan "user_count" — UsageSnapshot bilan bog'lash
  isActive    Boolean     @default(true)

  // ── MODUL REYESTRIDAN SINXRONLANADIGAN MAYDONLAR ───────────────────────
  //
  // ⚠ YAGONA HAQIQAT MANBAI SHU YERDA EMAS. Bu uch ustunni
  // `admin_server/scripts/sync-features.mjs` tenant kodidagi reyestrdan
  // (`server/src/common/features/feature-registry.ts`) ko'chirib yozadi.
  // Sabab: bog'liqlik grafigi KOD bo'lishi shart — uni haqiqiy NestJS
  // import'lariga qarshi tekshirib turamiz. Bu yerda esa uning ish
  // vaqtidagi PROYEKSIYASI turadi, chunki admin_server tenant kodini
  // import qila olmaydi.
  //
  // Qo'lda tahrirlamang: keyingi sinxronlash ustiga yozadi.

  /// Bu kalit MODUL o'chirgichimi (yoqilsa `parentKey`/`requiresKeys` ma'noli).
  isModule Boolean @default(false)

  /// TIZIM O'ZAGI — XAVFLI, LEKIN O'CHIRILADI.
  ///
  /// ⚠ MA'NOSI O'ZGARDI. Ilgari "o'chirgich ko'rsatilmaydi" degani edi.
  /// Endi o'chirgich bor, faqat panel qizil ogohlantirish va qo'shimcha
  /// tasdiq so'raydi. "O'chirib bo'lmaydi" endi `isLocked`.
  isCore Boolean @default(false)

  /// HECH QACHON O'CHMAYDI — o'chirgich yo'q, `setOverride()` 409 beradi.
  ///
  /// Atigi ikki kalit: `auth` (o'chsa tenantga hech kim kira olmaydi) va
  /// `features` (o'chsa `GET /features` ning o'zi 402 qaytaradi va
  /// tenantni tashqaridan tuzatib bo'lmaydi). Ikkalasining sababi ham
  /// TEXNIK — tijorat qarori emas.
  isLocked Boolean @default(false)

  /// Ota modul kaliti — imkoniyat (capability) uchun. Otasi o'chiq bo'lsa bola ham o'chiq.
  parentKey String?

  /// Shu bo'lim ishlashi uchun ochiq bo'lishi SHART bo'lgan kalitlar.
  requiresKeys String[] @default([])

  planFeatures PlanFeature[]
  addons       Addon[]
  overrides    TenantFeatureOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id          String       @id @default(cuid())
  key         String       @unique // "free", "basic", "pro"
  name        String
  description String?
  price       Decimal      @default(0) @db.Decimal(12, 2)
  currency    String       @default("UZS")
  interval    BillingCycle @default(MONTHLY)
  trialDays   Int          @default(0)
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  isPublic    Boolean      @default(true) // client panelda ko'rinadimi

  features      PlanFeature[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tarif ichidagi konkret limit/imkoniyat qiymati.
// value: LIMIT uchun son (1000), BOOLEAN uchun 0/1. -1 = cheksiz.
model PlanFeature {
  id        String  @id @default(cuid())
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId    String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId String
  value     Int

  @@unique([planId, featureId])
  @@index([featureId])
}

// Alohida sotib olinadigan qo'shimcha xizmat (add-on).
model Addon {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  price       Decimal  @default(0) @db.Decimal(12, 2)
  currency    String   @default("UZS")
  // Qaysi feature'ni yoqadi/oshiradi
  feature     Feature? @relation(fields: [featureId], references: [id])
  featureId   String?
  value       Int      @default(1) // feature qiymatiga qo'shiladi (BITTA birlik)
  isActive    Boolean  @default(true)

  // ⚠ PAKETLARNING O'ZI ALOHIDA `Addon` QATORLARI ("+1", "+5", "+10") —
  // ular kodda emas, bazada. Narx yoki paket to'plami o'zgarsa deploy
  // kerak emas. Bu yerda faqat BITTA qo'shimcha chegara turadi:
  //
  //   bitta loyiha shu paketdan NECHTA marta sotib olishi mumkin.
  //   null = paket darajasida cheklanmagan (umumiy `BRANCH_LIMIT_MAX`
  //   baribir amal qiladi).
  maxQuantity Int?

  tenantAddons TenantAddon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantAddon {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  addon    Addon  @relation(fields: [addonId], references: [id], onDelete: Cascade)
  addonId  String

  // NECHTA BIRLIK SOTIB OLINGAN.
  //
  // ⚠ `@@unique([tenantId, addonId])` sababli bitta add-on tenantga FAQAT
  // BIR MARTA biriktiriladi — "yana 3 ta filial" uchun ikkinchi qator
  // ochib bo'lmaydi. Shuning uchun miqdor QATOR ICHIDA turadi va yakuniy
  // qo'shimcha = `addon.value * quantity`.
  //
  // Standart 1 — eski yozuvlar (AI add-on'lari) aynan bitta birlik.
  quantity Int @default(1)

  isActive  Boolean   @default(true)
  expiresAt DateTime?

  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())

  @@unique([tenantId, addonId])
}

// ============================================================================
// OBUNA VA TO'LOV
// ============================================================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE // muddat o'tdi, hali to'lanmadi (grace period)
  CANCELED
  EXPIRED
}

model Subscription {
  id         String    @id @default(cuid())
  // Bitta tenantda bitta faol obuna
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String    @unique
  plan       Plan      @relation(fields: [planId], references: [id])
  planId     String
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  status           SubscriptionStatus @default(TRIALING)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime?
  canceledAt       DateTime?

  // --- Bepul sinov ---
  //
  // Sinovni FAQAT admin beradi (self-service oqimida berilmaydi), shuning
  // uchun "kim berdi" yozib qo'yiladi: keyinchalik "bu markaz nega bepul
  // ishlayapti?" degan savolga javob shu yerda turadi.
  trialDays      Int? // nechta kunga berilgan (7-30)
  trialGrantedBy String? // admin email
  trialGrantedAt DateTime?
  trialNote      String?

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([planId])
  @@index([currentPeriodEnd])
}

enum PaymentProvider {
  PAYME
  CLICK
  MANUAL // qo'lda (naqd/bank o'tkazma) — admin tasdiqlaydi
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
  FAILED
}

model Transaction {
  id             String        @id @default(cuid())
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerId     String?

  amount   Decimal         @db.Decimal(12, 2)
  currency String          @default("UZS")
  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  // Provayder tomonidagi tranzaksiya id (Payme/Click) — idempotentlik uchun
  providerTxnId String?
  rawPayload    String?   @db.Text
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Bu to'lov qaysi tijorat o'zgarishini qopladi (hozircha bo'sh —
  // billing ulanganda to'ldiriladi). Qarang: TenantCommercialChange.
  commercialChanges TenantCommercialChange[]

  @@unique([provider, providerTxnId])
  @@index([status])
  @@index([customerId])
}

// ============================================================================
// USAGE (heartbeat orqali tenant serverdan keladi)
// ============================================================================

// Har heartbeat bitta snapshot yozadi — tarix uchun (grafik chizish mumkin).
model UsageSnapshot {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  metricKey  String // "user_count", "student_count", "storage_mb"
  value      Int
  recordedAt DateTime @default(now())

  @@index([tenantId, metricKey, recordedAt])
}

// ============================================================================
// API XIZMATLAR (edu.pronauns va h.k.) — kalit bilan sotiladigan mahsulotlar
//
// Bu yuqoridagi Plan/Subscription'dan ATAYLAB alohida. U yerda mijoz = tenant
// (o'quv markaz), bu yerda mijoz = API kaliti bilan murojaat qiladigan ilova.
// Limitlar ham boshqacha: u yerda "nechta o'quvchi", bu yerda "sekundiga
// nechta so'rov".
//
// admin_server = CONTROL PLANE (tarif, muddat, kalit, hisob).
// Xizmatning o'zi (python) = DATA PLANE: kalitni shu yerdan so'rab oladi,
// keshlaydi va limitni O'ZI majburlaydi — shunda har so'rovda tarmoqqa
// chiqilmaydi va admin server o'chsa ham xizmat darrov to'xtamaydi.
// ============================================================================

enum ApiSubscriptionStatus {
  ACTIVE // ishlaydi
  SUSPENDED // admin qo'lda to'xtatdi (to'lov yo'q, suiiste'mol)
  EXPIRED // muddati o'tdi (avtomatik qo'yiladi)
  CANCELED // mijoz voz kechdi
}

// Sotiladigan API xizmat. Birinchisi — "edu-pronauns" (talaffuz baholash).
model ApiService {
  id          String  @id @default(cuid())
  key         String  @unique // "edu-pronauns"
  name        String
  description String?
  baseUrl     String? // https://speech.sevenedu.org
  docsUrl     String?
  isActive    Boolean @default(true)

  tiers         ApiTier[]
  subscriptions ApiSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tarif pog'onasi. Bu yerdagi raqamlarni data plane AYNAN o'sha holicha
// majburlaydi — shuning uchun tarifni o'zgartirish = xizmat tezligini
// o'zgartirish, kod tegilmaydi.
//
// NEGA "tezlik" = slot + rpm + ustuvorlik: inference narxi qat'iy (bitta
// so'rov ~100 ms CPU'da), bir xil temirda bitta so'rovni tezlashtirib
// bo'lmaydi. Yuqori tarif ko'proq parallel slot va navbatda oldinlik oladi —
// yuklama ostida u haqiqatan 2x/4x ko'p ish bajaradi.
model ApiTier {
  id        String     @id @default(cuid())
  service   ApiService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String
  key       String // "basic", "pro", "max"
  name      String

  price    Decimal      @default(0) @db.Decimal(12, 2)
  currency String       @default("USD")
  interval BillingCycle @default(MONTHLY)

  // --- majburlanadigan qiymatlar ---
  concurrency  Int @default(1) // bir vaqtda nechta so'rov ishlaydi
  rateLimitRpm Int @default(60) // daqiqasiga nechta so'rov
  priority     Int @default(3) // navbatdagi o'rin, 1 = eng oldin
  monthlyQuota Int @default(-1) // oyiga nechta so'rov, -1 = cheksiz

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  subscriptions ApiSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, key])
}

// API mijozi. Mustaqil yozuv — Customer yoki Tenant'ga bog'lash IXTIYORIY,
// shunda o'z kompaniyamizga ham, tashqi mijozga ham bir xil kalit beriladi.
model ApiConsumer {
  id    String  @id @default(cuid())
  label String // "SevenEdu (o'zimiz)"
  email String?
  note  String?

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  tenantId   String?

  isActive Boolean @default(true)

  subscriptions ApiSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([tenantId])
}

// Bitta mijozning bitta xizmatga obunasi = tarif + muddat.
model ApiSubscription {
  id         String      @id @default(cuid())
  consumer   ApiConsumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  consumerId String
  service    ApiService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId  String
  tier       ApiTier     @relation(fields: [tierId], references: [id])
  tierId     String

  status     ApiSubscriptionStatus @default(ACTIVE)
  startedAt  DateTime              @default(now())
  // null = muddatsiz. O'tgan sana = xizmat to'xtaydi (grace period yo'q).
  expiresAt  DateTime?
  canceledAt DateTime?

  // Oxirgi HISOBLANGAN so'rov vaqti (kalit tekshiruvi emas — haqiqiy so'rov).
  // Panelda "hisob tirikmi" savoliga shu javob beradi: raqamlar o'smayotgan
  // bo'lsa, xizmat usage yubormayotganini darrov ko'rasiz.
  lastRequestAt DateTime?

  keys  ApiKey[]
  usage ApiUsageDaily[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consumerId, serviceId])
  @@index([status])
}

// API kaliti. To'liq kalit BAZADA SAQLANMAYDI — faqat prefiksi (qidiruv uchun)
// va sha256 hash'i. Baza dumpi sizib chiqsa ham kalitlar bilan xizmatga
// kirib bo'lmaydi.
//
// Format: "pk_<8 belgi>.<43 belgi sir>" — nuqtagacha bo'lgan qism prefix.
model ApiKey {
  id             String          @id @default(cuid())
  subscription   ApiSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String

  prefix String  @unique // "pk_a1b2c3d4" — UI da ko'rsatiladi, lookup indeksi
  hash   String // sha256(prefix + "." + secret)
  label  String?

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdBy  String? // qaysi admin yaratdi (email)

  createdAt DateTime @default(now())

  @@index([subscriptionId])
}

// So'rovlarning kunlik yig'indisi. Har so'rov alohida qator bo'lsa jadval
// tez shishadi — data plane lokalda sanaydi va har 15 soniyada shu yerga
// qo'shib yuboradi.
model ApiUsageDaily {
  id             String          @id @default(cuid())
  subscription   ApiSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String
  day            DateTime        @db.Date
  endpoint       String          @default("assess")

  ok       Int @default(0) // muvaffaqiyatli
  rejected Int @default(0) // limit/muddat sababli rad etilgan (402/403/429)
  failed   Int @default(0) // xizmat xatosi (5xx)
  // Umumiy ishlov vaqti — o'rtacha latency shundan hisoblanadi.
  // Kuniga chegara ~1.9M so'rov x 200 ms = 380M, Int (2.1 mlrd) yetadi.
  totalMs  Int @default(0)

  @@unique([subscriptionId, day, endpoint])
  @@index([subscriptionId, day])
}

// ============================================================================
// TELEGRAM BOTLAR — paneldan VPS'ga chiqariladigan botlar
//
// Bu tenant provisioningining ko'zgusi: skript ENV orqali chaqiriladi, holat
// shu yerda yangilanadi, panel uni so'rab turadi. Farqi — bot yengilroq:
// baza yo'q, client build yo'q, ko'pincha domen ham kerak emas.
// ============================================================================

enum BotRuntime {
  NODEJS
  PHP
}

// Botning Telegram bilan gaplashish usuli.
//
// Bu foydalanuvchidan SO'RALMAYDI, runtime'dan kelib chiqadi:
//   NODEJS -> POLLING  (domen, nginx, sertifikat kerak emas — eng sodda)
//   PHP    -> WEBHOOK  (PHP uzluksiz jarayon sifatida getUpdates qila olmaydi)
// Noto'g'ri juftlikni tanlash imkoni bo'lmasligi kerak.
enum BotMode {
  POLLING
  WEBHOOK
}

enum BotSource {
  REPO // GitHub repodan clone qilinadi
  TEMPLATE // VPS'dagi tayyor shablondan nusxalanadi
}

enum BotStatus {
  DRAFT // yozuv yaratildi, hali deploy qilinmagan
  PROVISIONING // bot-provision.sh ishlayapti
  ACTIVE // ishlab turibdi
  FAILED // deploy xatosi
  STOPPED // qo'lda to'xtatilgan (pm2 stop / webhook olib tashlangan)
  DEPROVISIONING // bot-deprovision.sh ishlayapti
  DELETED // VPS'dan o'chirilgan, yozuv arxiv sifatida qoldi
}

// VPS'da oldindan tayyor turgan bot shabloni — SystemTemplate bilan bir xil
// g'oya. Papkaning o'zi VPS'da, bu yerda faqat unga ishora.
model BotTemplate {
  id          String     @id @default(cuid())
  key         String     @unique // "qabul-bot"
  name        String
  description String?
  runtime     BotRuntime
  templateDir String // /root/bot-templates/qabul-bot
  // Node uchun kirish fayli ("bot.js"). PHP'da kirish nuqtasi nginx
  // konfiguratsiyasi orqali belgilanadi, shuning uchun null bo'lishi mumkin.
  entryFile   String?
  isActive    Boolean    @default(true)

  bots Bot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bot {
  id   String @id @default(cuid())
  name String
  // Bitta qiymat uch joyda ishlatiladi: subdomen, pm2 nomi va papka nomi.
  // Shuning uchun u qat'iy shaklda va noyob bo'lishi shart.
  slug String @unique

  runtime BotRuntime
  mode    BotMode
  source  BotSource

  // source = REPO
  repoUrl    String?
  repoBranch String  @default("main")

  // source = TEMPLATE
  template   BotTemplate? @relation(fields: [templateId], references: [id])
  templateId String?

  // Telegram tokeni SHIFRLANGAN holda: "v1:iv:tag:data"
  // (common/crypto/secrets.util.ts). Javoblarda hech qachon ochiq qaytmaydi.
  tokenEnc    String
  // getMe javobidan — panelda "@bot_username" ko'rsatish uchun
  botUsername String?

  // Node bot pm2 ostida ishlaydi. PHP botda pm2 process yo'q, lekin nom
  // baribir ajratiladi — nginx vhost va papka nomi shundan yasaladi.
  pm2Name String @unique
  // Faqat Node+webhook uchun kerak bo'ladi. Hozircha Node polling'da
  // ishlagani uchun bo'sh qoladi, lekin diapazon oldindan ajratilgan.
  port    Int?   @unique

  webhookUrl    String?
  // Telegram `secret_token` — webhook'ga kelgan so'rov haqiqatan Telegram'dan
  // ekanini tekshiradi (X-Telegram-Bot-Api-Secret-Token sarlavhasi).
  webhookSecret String?

  status         BotStatus @default(DRAFT)
  deployLog      String?   @db.Text
  failureReason  String?
  lastDeployedAt DateTime?

  // Ixtiyoriy bog'lanish — bot mustaqil ham yashay oladi
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  tenantId   String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  env BotEnvVar[]

  createdBy String? // qaysi admin yaratdi (email)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tenantId])
  @@index([customerId])
}

// Botning qo'shimcha .env qiymatlari (ADMIN_CHAT_ID, API_URL va h.k.).
// BOT_TOKEN bu yerda SAQLANMAYDI — u Bot.tokenEnc da.
model BotEnvVar {
  id    String @id @default(cuid())
  bot   Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)
  botId String
  key   String

  // isSecret bo'lsa shifrlangan, aks holda ochiq — TenantSetting bilan
  // bir xil qoida.
  value    String  @db.Text
  isSecret Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([botId, key])
  @@index([botId])
}

// ============================================================================
// TIJORAT KONFIGURATSIYASI TARIXI (audit)
//
// ⚠ BU BILLING EMAS. Hisob-kitob (`Transaction`), obuna (`Subscription`) va
// imkoniyatlar (`Plan`/`Addon`/`TenantAddon`) allaqachon bor va ULAR
// TAKRORLANMAYDI. Bu jadval faqat BITTA savolga javob beradi:
//
//   "Bu loyihaning filial chegarasini KIM, QACHON, QANCHAGA va NEGA
//    o'zgartirdi?"
//
// Javob hozir hech qayerda yozilmaydi: `Tenant.branchLimitOverride` va
// `TenantAddon.quantity` faqat OXIRGI holatni bildiradi. Chegara ko'tarilib
// keyin tushirilsa, oradagi voqea butunlay yo'qoladi — aynan pul haqidagi
// bahsda kerak bo'ladigan ma'lumot.
//
// ⚠ HAR YOZUV YAKUNIY CHEGARANI HAM SAQLAYDI (`limitBefore/After`).
// Sabab: chegara UCH manbadan yig'iladi (override, tarif, paketlar) va
// keyinchalik tarif o'zgarsa, eski yozuvlarni qayta hisoblab bo'lmaydi.
// Natijaning O'ZI yozilmasa, tarix o'qib bo'lmas holga kelardi.
//
// To'lov ulanganda `transactionId` to'ldiriladi va "o'zgarish ↔ to'lov"
// zanjiri yopiladi — shuning uchun maydon HOZIRDAN bor, lekin ixtiyoriy.
// ============================================================================

enum CommercialChangeSource {
  DEVELOPER_ADMIN // paneldan qo'lda (hozirgi yagona yo'l)
  BILLING // to'lov muvaffaqiyatli o'tgach avtomatik (kelajak)
  SYSTEM // migratsiya/seed/tuzatish
}

// Nima o'zgardi. Bittasi — bitta amal; bir so'rovda ikkitasi o'zgarsa
// (rejim + chegara) IKKI yozuv tushadi, chunki ular boshqa-boshqa
// sabablarga ega bo'ladi.
enum CommercialChangeAction {
  LIMIT_OVERRIDE // qo'lda qo'yilgan chegara (yoki uning bekor qilinishi)
  BRANCH_MODE // ko'p filialli / yakka markaz rejimi
  ADDON_GRANT // pullik paket biriktirildi yoki miqdori oshdi
  ADDON_REVOKE // paket olib tashlandi
  MODULE_TOGGLE // bo'lim (modul) yoqildi yoki o'chirildi
}

model TenantCommercialChange {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  // QAYSI imkoniyat — "max_branches". `Feature` ga FK EMAS: audit yozuvi
  // feature o'chirilsa ham o'qilishi kerak.
  featureKey String
  action     CommercialChangeAction

  // --- TIJORAT: pullik paket ---
  addonKey       String?
  quantityBefore Int?
  quantityAfter  Int?

  // --- TEXNIK: loyiha konfiguratsiyasi ---
  // null = "qo'yilmagan" (tarif/standart amal qiladi). Shuning uchun
  // Int? — 0 bilan aralashib ketmasin.
  overrideBefore Int?
  overrideAfter  Int?
  enabledBefore  Boolean?
  enabledAfter   Boolean?

  // --- NATIJA: mijoz amalda ko'radigan raqam ---
  limitBefore  Int // -1 = cheksiz
  limitAfter   Int
  // O'sha paytdagi ochilgan filiallar (oxirgi heartbeat). Metrika hali
  // kelmagan bo'lsa null — 0 EMAS: nol "filial yo'q" degan ma'lumot.
  usedAtChange Int?

  // --- NARX SURATI ---
  // Narx keyin o'zgarsa ham tarix haqiqat bo'lib qoladi.
  unitPrice Decimal? @db.Decimal(12, 2)
  currency  String?
  amount    Decimal? @db.Decimal(12, 2)

  source CommercialChangeSource @default(DEVELOPER_ADMIN)
  actor  String? // admin emaili; tizim yozuvida null
  reason String?                @db.Text

  // To'lov bilan bog'lash — HOZIRCHA BO'SH (billing ulanmagan).
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  transactionId String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([featureKey])
}

// ═══════════════════════════════════════════════════════════════════════════
// MODUL O'CHIRGICHI — LOYIHA DARAJASIDAGI USTUN QAROR.
//
// YECHISH TARTIBI (`EntitlementsService.forTenant`):
//     TenantFeatureOverride  →  PlanFeature (faol obuna)  →  standart O'CHIQ
//
// ⚠ NEGA TARIFNING O'ZI YETMAYDI
//   "Bitta mijozga davomatni yoqib qo'y" so'rovi tarif bilan hal qilinsa,
//   har bunday holat uchun ALOHIDA tarif tug'ilardi va bir yildan keyin
//   40 ta bir martalik "pro-plus-najot" tarifi qolardi. Ustun qaror esa
//   tarifni buzmaydi: paket o'z o'rnida, istisno esa qayd etilgan va
//   sababi yozilgan.
//
// ⚠ MAVJUD LOYIHALARNI SAQLASH (grandfather)
//   Kalitlar joriy qilinganda HAR BIR faol loyihaga shu jadval orqali
//   ochiq qilib beriladi — obunasi bor-yo'qligidan qat'i nazar. Aks holda
//   kalitlarni joriy qilgan deploy hamma mijozning bo'limlarini birdan
//   o'chirib qo'yardi.
//
// ⚠ `branchId` HOZIRCHA DOIM null
//   Filial darajasidagi o'chirgich ATAYLAB QURILMAGAN (ikki qavatli
//   yechish mantig'i va "nega ko'rinmayapti" savolining ikki qavatli
//   otladi). Ustun esa hozir qo'yiladi: keyinchalik kerak bo'lsa
//   migratsiyasiz ochiladi.
// ═══════════════════════════════════════════════════════════════════════════
model TenantFeatureOverride {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId String

  /// Kalitning O'ZI ham saqlanadi — audit va sinxronlashda qulay.
  featureKey String

  /// true = majburan ochiq, false = majburan yopiq. Qator yo'q = tarif hal qiladi.
  enabled Boolean

  /// ⚠ MAJBURIY. Olti oydan keyin "nega bu loyihada bepul?" degan savolga javob.
  reason String

  /// Kelajak uchun zaxira — hozir DOIM "" (loyiha darajasi).
  ///
  /// ⚠ NEGA `String?` EMAS: PostgreSQL unique indeksda NULL'larni BIR-BIRIGA
  /// TENG DEB HISOBLAMAYDI. Nullable bo'lganda `@@unique` amalda ishlamas,
  /// `upsert` esa har bosishda YANGI qator yaratib, eski ustun qaror
  /// jimgina kuchda qolardi. Bo'sh satr sentineli bu teshikni yopadi.
  branchId String @default("")

  createdBy String // admin email
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, featureKey, branchId])
  @@index([tenantId])
  @@index([featureId])
}
