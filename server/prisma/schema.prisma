// ─────────────────────── XAZINA / BUXGALTERIYA ───────────────────────

model Account {
  id       String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId String @db.VarChar(24)
  branch   Branch @relation("AccountBranch", fields: [branchId], references: [id])
  kind     AccountKind
  // FAQAT due_from / due_to uchun: qaysi filial bilan hisob-kitob.
  counterpartyBranchId String? @db.VarChar(24)
  counterpartyBranch   Branch? @relation("AccountCounterparty", fields: [counterpartyBranchId], references: [id])
  name     String  @default("")
  currency String  @default("UZS")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[] @relation("JournalLineAccount")

  // DIQQAT: Mongo'da (branchId, kind, counterpartyBranchId) unique edi va
  // NULL'lar TENG sanalardi. Postgres'da NULL'lar teng EMAS — shuning uchun
  // migratsiyada IKKITA qisman unique indeks yaratiladi:
  //   a) (branchId, kind, counterpartyBranchId) WHERE counterpartyBranchId IS NOT NULL
  //   b) (branchId, kind)                       WHERE counterpartyBranchId IS NULL
  @@index([branchId])
  @@index([counterpartyBranchId])
  @@map("accounts")
}

model JournalEntry {
  id       String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId String @db.VarChar(24)
  branch   Branch @relation("JournalBranch", fields: [branchId], references: [id])
  date     DateTime
  kind     EntryKind
  memo     String @default("")
  refModel String?
  refId    String? @db.VarChar(24)
  isInternal Boolean @default(false)
  counterpartyBranchId String? @db.VarChar(24)
  counterpartyBranch   Branch? @relation("JournalCounterparty", fields: [counterpartyBranchId], references: [id])
  totalDebit  Float
  totalCredit Float
  createdById String? @db.VarChar(24)
  createdBy   User?   @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[] @relation("JournalLineEntry")

  @@index([branchId, date])
  @@index([date])
  @@index([kind])
  @@index([refId])
  @@index([isInternal])
  @@map("journal_entries")
}

// Mongo'da JournalEntry ichidagi massiv edi. Alohida jadval — `lines.accountId`
// bo'yicha indeks va hisob qoldig'ini yig'ish (aggregate) shu ustunga tayanadi.
model JournalLine {
  id        String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  entryId   String @db.VarChar(24)
  entry     JournalEntry @relation("JournalLineEntry", fields: [entryId], references: [id], onDelete: Cascade)
  accountId String @db.VarChar(24)
  account   Account @relation("JournalLineAccount", fields: [accountId], references: [id])
  accountKind String
  debit     Float  @default(0)
  credit    Float  @default(0)

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Shift {
  id        String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId  String @db.VarChar(24)
  branch    Branch @relation("ShiftBranch", fields: [branchId], references: [id])
  cashierId String @db.VarChar(24)
  cashier   User   @relation("ShiftCashier", fields: [cashierId], references: [id])
  openedAt  DateTime
  openedById String? @db.VarChar(24)
  openedBy   User?   @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedAt  DateTime?
  closedById String? @db.VarChar(24)
  closedBy   User?   @relation("ShiftClosedBy", fields: [closedById], references: [id])
  openingCash  Float @default(0)
  expectedCash Float?
  countedCash  Float?
  variance     Float?
  varianceNote String @default("")
  status    ShiftStatus @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashTransfers CashTransfer[] @relation("TransferShift")

  // QISMAN UNIQUE: (branchId, cashierId) WHERE status = 'open'
  // — bitta kassirda bir vaqtda bitta ochiq smena.
  @@index([branchId, openedAt])
  @@index([cashierId])
  @@index([status])
  @@map("shifts")
}

model CashTransfer {
  id           String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  fromBranchId String @db.VarChar(24)
  fromBranch   Branch @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId   String @db.VarChar(24)
  toBranch     Branch @relation("TransferTo", fields: [toBranchId], references: [id])
  amount       Float
  countedOnArrival Float?
  discrepancy      Float?
  status     TransferStatus @default(in_transit)
  sentById   String? @db.VarChar(24)
  sentBy     User?   @relation("CashTransferSentBy", fields: [sentById], references: [id])
  sentAt     DateTime
  receivedById String? @db.VarChar(24)
  receivedBy   User?   @relation("CashTransferReceivedBy", fields: [receivedById], references: [id])
  receivedAt DateTime?
  shiftId    String? @db.VarChar(24)
  shift      Shift?  @relation("TransferShift", fields: [shiftId], references: [id])
  note       String  @default("")
  discrepancyNote String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromBranchId])
  @@index([toBranchId, status])
  @@index([status, sentAt])
  @@map("cash_transfers")
}

model OpeningBalance {
