enum AccountKind {
  cash
  terminal
  click
  payme
  bank
  transit
  due_from
  due_to
  deposit
  equity
  revenue
  expense
  shortage

  // ── FAZA 3: qo'shimcha to'lov kanallari ──
  uzcard
  humo
  // Boshqa/aralash kanal (nomi Account.name da).
  other

  // ── FAZA 13: EGASINING PULI ──
  // `equity` DAN ATAYLAB AJRATILGAN. `equity` — boshlang'ich qoldiqning
  // qarshi tomoni (tizimga o'tish arxeologiyasi). Bu esa TIRIK oqim:
  // egasi biznesga pul qo'shadi yoki oladi.
  //
  // Ikkalasi ham DAROMAD/XARAJAT EMAS: egasi 20 mln qo'shsa kassa oshadi,
  // lekin markaz hech narsa SOTMAGAN. Aralashtirilsa "foyda" yolg'on
  // ko'tarilib, eng muhim savol — "biznes o'zi pul topayaptimi?" —
  // javobsiz qolardi.
  owner_capital

  // ── FAZA 12: TO'LOV TIZIMI KOMISSIYASI ──
  // `expense` dan ajratilgan: bu markaz QARORI bilan qilingan xarajat
  // emas, tushumdan AVTOMATIK ushlanadigan ulush. Alohida hisob
  // "to'lov qabul qilish bizga qancha turadi?" savoliga to'g'ridan-to'g'ri
  // javob beradi (provayderni almashtirish qarori shunga tayanadi).
  payment_fee
}

