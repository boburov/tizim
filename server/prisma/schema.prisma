// ─────────────────────── XAZINA / BUXGALTERIYA ───────────────────────

model Account {
  id       String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId String @db.VarChar(24)
  branch   Branch @relation("AccountBranch", fields: [branchId], references: [id])
  kind     AccountKind
  // FAQAT due_from / due_to uchun: qaysi filial bilan hisob-kitob.
  counterpartyBranchId String? @db.VarChar(24)
  counterpartyBranch   Branch? @relation("AccountCounterparty", fields: [counterpartyBranchId], references: [id])
  name     String  @default("")
  currency String  @default("UZS")
  isActive Boolean @default(true)

  // ── FAZA 3: BOSHLANG'ICH QOLDIQ ──
  // Tizimga o'tishdan oldin kassada bo'lgan pul. Jurnal bo'sh bo'lsa ham
  // hisob qoldig'i HAQIQIY bo'lishi kerak.
  //
  // DIQQAT: `currentBalance` USTUNI ATAYLAB YO'Q. U jurnaldan hisoblanadi
  // (`journal.balances()`). Saqlangan qoldiq MUQARRAR eskiradi — to'lov
  // yozilib, qoldiq yangilanmay qolsa, qaysi biri haqiqat ekani noma'lum
  // bo'lardi. Bu yerda haqiqat bitta: JURNAL QATORLARI.
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  openingAt      DateTime?
  // UI da ko'rsatish tartibi (Kassa → Bank → Click ...).
  sortOrder      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[] @relation("JournalLineAccount")

  // DIQQAT: Mongo'da (branchId, kind, counterpartyBranchId) unique edi va
  // NULL'lar TENG sanalardi. Postgres'da NULL'lar teng EMAS — shuning uchun
  // migratsiyada IKKITA qisman unique indeks yaratiladi:
  //   a) (branchId, kind, counterpartyBranchId) WHERE counterpartyBranchId IS NOT NULL
  //   b) (branchId, kind)                       WHERE counterpartyBranchId IS NULL
  @@index([branchId])
  @@index([counterpartyBranchId])
  @@map("accounts")
}

model JournalEntry {
  id       String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId String @db.VarChar(24)
  branch   Branch @relation("JournalBranch", fields: [branchId], references: [id])
  date     DateTime
  kind     EntryKind
  memo     String @default("")
  refModel String?
  refId    String? @db.VarChar(24)

  // ═══════════════════════════════════════════════════════════════════
  // IDEMPOTENTLIK KALITI (STEP 4)
  // ═══════════════════════════════════════════════════════════════════
  //
  // MUAMMO: takroriy urinish (webhook qayta yuborilishi, cron qayta
  // ishga tushishi, double-click, tarmoq uzilgach retry) BIR XIL pulni
  // IKKI MARTA yozib qo'yishi mumkin. Jurnal muvozanatda qoladi —
  // ya'ni `reconcile()` ham buni TOPMAYDI — lekin kassada yo'q pul
  // paydo bo'ladi. Bu eng yomon turdagi xato: jimgina va o'z-o'zidan
  // "to'g'ri" ko'rinadi.
  //
  // NEGA (refModel, refId) YETARLI EMAS: bitta manba ATAYLAB bir
  // nechta yozuv tug'diradi —
  //   • inkassatsiya: bitta CashTransfer → `transfer_send` (jo'natuvchi
  //     filial) + `transfer_receive` (qabul qiluvchi filial)
  //   • o'quvchini ko'chirish: bitta User → ikkita `inter_branch` yozuv,
  //     va o'quvchi KEYIN yana ko'chirilishi mumkin
  // Ular ustidagi unique indeks haqiqiy amallarni bloklab qo'yardi.
  //
  // Shuning uchun kalit OCHIQ va MA'NOLI beriladi:
  //   "payment:<paymentTransactionId>"
  //   "expense:<expenseId>"
  //   "refund:<refundId>"
  //   "transfer_send:<cashTransferId>" / "transfer_receive:<...>"
  //   "salary_teacher:<salaryTransactionId>"
  //
  // NULLABLE — ataylab: kalitsiz yozuv (qo'lda tuzatish, smena yopilishi)
  // hamon yozilaveradi. Postgres'da NULL != NULL, ya'ni kalitsiz
  // yozuvlar bir-birini bloklamaydi.
  postingKey String? @unique

  isInternal Boolean @default(false)
  counterpartyBranchId String? @db.VarChar(24)
  counterpartyBranch   Branch? @relation("JournalCounterparty", fields: [counterpartyBranchId], references: [id])
  totalDebit  Decimal @db.Decimal(18, 2)
  totalCredit Decimal @db.Decimal(18, 2)
  createdById String? @db.VarChar(24)
  createdBy   User?   @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])

  // ═══════════════════════════════════════════════════════════════════
  // O'LCHOVLAR (dimensions) — Faza 1, 7, 16-19 ning POYDEVORI
  // ═══════════════════════════════════════════════════════════════════
  //
  // NEGA JURNALDA, alohida "financial_transactions" jadvalida EMAS:
  // ikkinchi jadval "operatsiya bo'ldi" deb, jurnal esa "kassada shuncha
  // pul bor" deb turardi va ular BIRINCHI xatodayoq ajralib ketardi.
  // Bu xato modelning O'ZIDA bo'lardi — keyin tuzatib bo'lmasdi.
  //
  // NEGA KERAK: "A o'qituvchi qancha foyda keltiradi?" degan savolga
  // javob bermoqchi bo'lsak, uni har safar QAYTA HISOBLASH kerak edi —
  // guruhlarni topib, ularning to'lovlarini yig'ib, o'sha davrdagi
  // maoshni ajratib... Har hisobot boshqacha yozilardi va ular o'zaro
  // TO'G'RI KELMASDI. Bu ustunlar bilan javob bitta `GROUP BY` ga
  // aylanadi va manba HAMMA JOYDA bitta.
  //
  // HAMMASI NULLABLE — VA BU ATAYLAB (talab: "Do NOT force irrelevant
  // relations"). Ijara chiqimida o'quvchi YO'Q; o'quvchi to'lovida xona
  // bo'lishi mumkin, lekin shart emas. Majburiy qilingan o'lchov
  // "bilmayman"ni yolg'on qiymat bilan to'ldirishga majburlardi.
  //
  // TO'LDIRISH VAQTI: yozuv yaratilayotganda, MANBADAN nusxalanadi
  // (denormalizatsiya). Guruhning xonasi keyin o'zgarsa, o'tmishdagi
  // yozuv o'z xonasida qoladi — tarix qayta yozilmaydi.

  // Kimga tegishli (uchtasi ham User, lekin ROLI boshqa — shuning uchun
  // alohida ustun: `teacherId IS NOT NULL` shartida indeks ishlaydi va
  // "o'qituvchi maoshi" bilan "o'quvchi to'lovi" chalkashmaydi).
  // ═══════════════════════════════════════════════════════════════════
  // EGALIK USTUNLARI — `onDelete: Restrict` (STANDART `SetNull` EMAS)
  //
  // Prisma ixtiyoriy (`?`) bog'lanishga STANDART holda `ON DELETE SET NULL`
  // qo'yadi. Jurnal uchun bu JIMGINA MA'LUMOT YO'QOTISH edi: o'quvchi,
  // o'qituvchi yoki guruh o'chirilganda yozuvning EGASI null bo'lib
  // qolardi. Summalar (`journal_lines`) joyida turardi, ya'ni
  // `reconcile()` ham, muvozanat tekshiruvi ham buni TOPMASDI — faqat
  // "bu pul KIMGA tegishli edi" degan javob yo'qolardi. Qaytarib
  // bo'lmaydigan tarzda.
  //
  // O'LCHANGAN (seed tekshiruvida): demo o'quvchi/o'qituvchi/guruhlarni
  // o'chirish 48 yozuvning HAMMASIDA `studentId`/`teacherId`/`groupId` ni
  // null qilib yubordi (oldin mos ravishda 25/23/17 tasi null edi).
  //
  // BU `config/prisma.js` DAGI O'ZGARMASLIK KENGAYTMASINI CHETLAB
  // O'TARDI: kengaytma `update`/`upsert` ni to'sadi, FK esa qatorni
  // BAZA ICHIDA o'zgartiradi — ilova qatlami buni umuman ko'rmaydi.
  //
  // ENDI: tarixi bor odamni/guruhni o'chirish XATO BERADI (23503).
  // Jurnal yozuvi hech qachon kaskadli o'chmaydi va o'zgartirilmaydi —
  // yagona to'g'ri yo'l avvalgidek storno (`journal.reverse()`).
  //
  // `staffId` ham shu uchlikning bir qismi (yuqoridagi izohga qarang:
  // "uchtasi ham User, lekin ROLI boshqa") — u ham xuddi shunday
  // egalikni bildiradi, shuning uchun bir xil qoida qo'llanadi.
  // ═══════════════════════════════════════════════════════════════════
  studentId String? @db.VarChar(24)
  student   User?   @relation("JournalStudent", fields: [studentId], references: [id], onDelete: Restrict)
  teacherId String? @db.VarChar(24)
  teacher   User?   @relation("JournalTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  // O'qituvchi BO'LMAGAN xodim (admin, kassir, farrosh) — Faza 7.
  staffId   String? @db.VarChar(24)
  staff     User?   @relation("JournalStaff", fields: [staffId], references: [id], onDelete: Restrict)

  groupId   String? @db.VarChar(24)
  group     Group?  @relation("JournalGroup", fields: [groupId], references: [id], onDelete: Restrict)
  // YO'NALISH (Faza 17). Guruhdan nusxalanadi.
  courseId  String? @db.VarChar(24)
  course    Course? @relation("JournalCourse", fields: [courseId], references: [id])
  // XONA (Faza 19). Guruhdan nusxalanadi.
  roomId    String? @db.VarChar(24)
  room      Room?   @relation("JournalRoom", fields: [roomId], references: [id])
  // A'ZOLIK (enrollment) — bitta o'quvchining bitta guruhdagi davri.
  membershipId String? @db.VarChar(24)
  membership   GroupMembership? @relation("JournalMembership", fields: [membershipId], references: [id])

  // CHIQIM KATEGORIYASI (Faza 2, 7, 10). Maosh yozuvi ham shu orqali
  // "Payroll" kategoriyasiga bog'lanadi — shunda byudjet/fakt taqqoslash
  // maoshni ham qamrab oladi.
  expenseCategoryId String? @db.VarChar(24)
  expenseCategory   ExpenseCategory? @relation("JournalExpenseCategory", fields: [expenseCategoryId], references: [id])

  // DAVR (Faza 7): "2026-avgust maoshi" oktabrda to'lansa ham AVGUSTGA
  // tegishli. `date` — pul harakati sanasi, bu esa tegishlilik davri.
  // Ikkalasi boshqa savolga javob beradi va ikkalasi ham kerak.
  periodYear  Int?
  periodMonth Int?

  // Qaysi kanal orqali (Faza 1, 12).
  paymentMethod PaymentMethod?
  // DOIMIY/O'ZGARUVCHAN (Faza 8) — chiqim yozuvlari uchun.
  costType      CostType?

  // Chek/kvitansiya (Faza 1, 2).
  attachmentId String? @db.VarChar(24)
  attachment   StoredFile? @relation("JournalAttachment", fields: [attachmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[] @relation("JournalLineEntry")

  @@index([branchId, date])
  @@index([date])
  @@index([kind])
  @@index([refId])
  @@index([isInternal])
  // O'LCHOV INDEKSLARI — analitika so'rovlari aynan shu shaklda keladi:
  // "shu davrda, shu o'qituvchi bo'yicha". Sanasiz indeks butun tarixni
  // o'qishga majburlardi.
  @@index([teacherId, date])
  @@index([studentId, date])
  @@index([staffId, date])
  @@index([groupId, date])
  @@index([courseId, date])
  @@index([roomId, date])
  @@index([expenseCategoryId, date])
  @@index([periodYear, periodMonth])
  @@map("journal_entries")
}

// Mongo'da JournalEntry ichidagi massiv edi. Alohida jadval — `lines.accountId`
// bo'yicha indeks va hisob qoldig'ini yig'ish (aggregate) shu ustunga tayanadi.
model JournalLine {
  id        String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  entryId   String @db.VarChar(24)
  entry     JournalEntry @relation("JournalLineEntry", fields: [entryId], references: [id], onDelete: Cascade)
  accountId String @db.VarChar(24)
  account   Account @relation("JournalLineAccount", fields: [accountId], references: [id])
  accountKind String
  debit     Decimal  @default(0) @db.Decimal(18, 2)
  credit    Decimal  @default(0) @db.Decimal(18, 2)

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Shift {
  id        String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId  String @db.VarChar(24)
  branch    Branch @relation("ShiftBranch", fields: [branchId], references: [id])
  cashierId String @db.VarChar(24)
  cashier   User   @relation("ShiftCashier", fields: [cashierId], references: [id])
  openedAt  DateTime
  openedById String? @db.VarChar(24)
  openedBy   User?   @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedAt  DateTime?
  closedById String? @db.VarChar(24)
  closedBy   User?   @relation("ShiftClosedBy", fields: [closedById], references: [id])
  openingCash  Decimal @default(0) @db.Decimal(18, 2)
  expectedCash Decimal? @db.Decimal(18, 2)
  countedCash  Decimal? @db.Decimal(18, 2)
  variance     Decimal? @db.Decimal(18, 2)
  varianceNote String @default("")
  status    ShiftStatus @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashTransfers CashTransfer[] @relation("TransferShift")

  // QISMAN UNIQUE: (branchId, cashierId) WHERE status = 'open'
  // — bitta kassirda bir vaqtda bitta ochiq smena.
  @@index([branchId, openedAt])
  @@index([cashierId])
  @@index([status])
  @@map("shifts")
}

model CashTransfer {
  id           String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  fromBranchId String @db.VarChar(24)
  fromBranch   Branch @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId   String @db.VarChar(24)
  toBranch     Branch @relation("TransferTo", fields: [toBranchId], references: [id])
  amount       Decimal @db.Decimal(18, 2)
  countedOnArrival Decimal? @db.Decimal(18, 2)
  discrepancy      Decimal? @db.Decimal(18, 2)
  status     TransferStatus @default(in_transit)
  sentById   String? @db.VarChar(24)
  sentBy     User?   @relation("CashTransferSentBy", fields: [sentById], references: [id])
  sentAt     DateTime
  receivedById String? @db.VarChar(24)
  receivedBy   User?   @relation("CashTransferReceivedBy", fields: [receivedById], references: [id])
  receivedAt DateTime?
  shiftId    String? @db.VarChar(24)
  shift      Shift?  @relation("TransferShift", fields: [shiftId], references: [id])
  note       String  @default("")
  discrepancyNote String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromBranchId])
  @@index([toBranchId, status])
  @@index([status, sentAt])
  @@map("cash_transfers")
}

model OpeningBalance {
  id     String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  userId String @unique @db.VarChar(24)
  user   User   @relation("OpeningBalanceUser", fields: [userId], references: [id])
  role   OpeningRole
  amount Decimal @db.Decimal(18, 2)
  signConvention OpeningSignConvention @default(flow)
  branchId String? @db.VarChar(24)
