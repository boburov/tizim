# ═══════════════════════════════════════════════════════════════════════════
# server_nest — MUHIT SOZLAMALARI
#
# ODATDA BU FAYL KERAK EMAS.
#
# NestJS ilovasi `../server/.env` ni O'QIYDI (qarang: src/app.module.ts).
# Sabab: ikkala ilova bir vaqtda, BITTA bazaga va bitta sozlamaga tayanib
# ishlaydi. Nusxa olingan `.env` muqarrar ravishda asl nusxadan uzoqlashadi
# va ikki ilova bir xil kalitni boshqacha o'qib qo'yadi.
#
# `server_nest/.env` yaratilsa u USTUN turadi — faqat LOKAL override uchun.
# ═══════════════════════════════════════════════════════════════════════════

# NestJS porti. Express `PORT` (standart 5000) da qoladi va TEGILMAYDI —
# ko'chirish davrida ikkala ilova birga ishlaydi, ya'ni portlar boshqa
# bo'lishi SHART.
NEST_PORT=5001

# ═══════════════════════════════════════════════════════════════════════════
# ⚠⚠ FON ISHLARI VA TELEGRAM BOT — IKKILANISH HIMOYASI ⚠⚠
#
# Express (`server/`) HOZIR yagona worker va yagona Telegram poller.
# Quyidagilarni yoqish = "bu jarayon o'sha navbatning EGASI" degani.
#
# KESIB O'TISH TARTIBI (oila bo'yicha, HAR DOIM shu ketma-ketlikda):
#   1. Express'da o'sha job oilasini to'xtating;
#   2. shundan KEYIN bu yerda yoqing.
# Ikkalasi birga ishlasa: dublikat bildirishnoma, dublikat Telegram
# xabari va (moliya oilasida) DUBLIKAT PUL HARAKATI.
#
# Batafsil: server_nest/WORKERS-DEPENDENCY-MATRIX.md §4
# ═══════════════════════════════════════════════════════════════════════════

# pg-boss worker'lari umuman ishga tushsinmi (standart: false).
NEST_WORKERS_ENABLED=false

# IZOLYATSIYA RO'YXATI — vergul bilan ajratilgan job nomlari.
# Bo'sh = hech biri (fail-closed). `*` = hammasi (FAQAT to'liq cutover'dan keyin).
# Hozir NestJS'ga ko'chirilganlari: daily.ttl-cleanup, usage.heartbeat
NEST_WORKER_JOBS=

# Telegram polling'ni SHU jarayon boshlasinmi (standart: false).
# false bo'lsa ham bot nusxasi yaratiladi — xabar YUBORISH polling talab qilmaydi.
# true bo'lganda ham `bot_locks` jadvalidagi `poller` qulfi ikkinchi pollerni to'sadi.
NEST_BOT_POLLING=false
