  overpaidAmount  Float @default(0)
  status    PayStatus @default(unpaid)
  isLocked  Boolean @default(false)
  lockedAt  DateTime?
  lockedById String? @db.VarChar(24)
  lockedBy   User?   @relation("TeacherSalaryLockedBy", fields: [lockedById], references: [id])
  source    SalarySource @default(auto)
