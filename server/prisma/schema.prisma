model PaymentTransaction {
  id        String   @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId  String   @db.VarChar(24)
  branch    Branch   @relation("PaymentTxBranch", fields: [branchId], references: [id])
  paymentId String   @db.VarChar(24)
  payment   StudentPayment @relation("PaymentTxPayment", fields: [paymentId], references: [id])
  studentId String   @db.VarChar(24)
  student   User     @relation("PaymentTxStudent", fields: [studentId], references: [id])
  groupId   String   @db.VarChar(24)
  group     Group    @relation("PaymentTxGroup", fields: [groupId], references: [id])
  year      Int
  month     Int
  // BRUTTO — o'quvchi TO'LAGAN summa. Bu ustun ma'nosi O'ZGARMAYDI:
  // o'quvchining qarzi aynan shu summaga kamayadi.
  amount    Decimal @db.Decimal(18, 2)

  // ── FAZA 12: TO'LOV TIZIMI KOMISSIYASI ──
  // O'quvchi 700 000 to'ladi, provayder 7 000 ushlab qoldi, kassaga
  // 693 000 tushdi. Uch raqamning UCHALASI ham kerak va ular BOSHQA
  // savolga javob beradi:
  //   amount    → o'quvchi qarzi qancha kamaydi (700 000)
  //   feeAmount → pul qabul qilish bizga qancha turdi (7 000)
  //   netAmount → kassa qoldig'i qancha oshdi (693 000)
  //
  // Ilgari faqat bittasi bo'lgani uchun ular jimgina ARALASHARDI:
  // brutto yozilsa kassa 7 000 ga oshib ketardi, netto yozilsa
  // o'quvchida 7 000 "qarz" qolib ketardi.
  //
  // default 0 → MAVJUD qatorlar uchun xulq-atvor aynan eski holicha
  // (komissiya yo'q, netto = brutto).
  feeAmount Decimal @default(0) @db.Decimal(18, 2)
