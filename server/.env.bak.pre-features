NODE_ENV=development
PORT=5000

# Brend nomi (o'quv markazi nomi). Bot matnlari, bildirishnomadagi
# {markaz} tokeni va Excel fayllarining muallif maydoni shundan oladi.
# Client tomonda ayni shu nom client/.env dagi VITE_APP_NAME'da turadi.
APP_NAME=LcSystem

# PostgreSQL (Prisma)
# Tenant bazasi. Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bayyina?schema=public&connection_limit=30&pool_timeout=20

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie
COOKIE_SECRET=dev_cookie_secret_change_me
COOKIE_DOMAIN=localhost

# CORS
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Telegram bot
TELEGRAM_BOT_TOKEN=8550485855:AAFDJf349cRgUWHMhSf7YI3YV4ZKxw12fd0
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_WEBAPP_URL=

# Ko'p filialli rejim. false = yakka o'quv markazi (filial UI'si yashiriladi).
MULTI_BRANCH=false

GEMINI_API_KEY=AIzaSyAStmA9OQXIShFI1bo-kr-pX9-FKfpNkvA

# ═══════════════════════════════════════════════════════════════════════
# CUTOVER — NESTJS ASOSIY SERVER (2026-08-22)
#
# Express TO'XTATILDI. NestJS 5000-portni egallaydi, ya'ni klient
# (`VITE_API_URL=http://localhost:5000/api`) O'ZGARTIRILMAYDI.
#
# ⚠ EXPRESS'NI QAYTA ISHGA TUSHIRMANG: uning `PORT` i ham 5000 va
# ikkalasi bir portni band qila olmaydi. Orqaga qaytish kerak bo'lsa
# avval NestJS'ni to'xtating, keyin bu blokni izohga oling.
# ═══════════════════════════════════════════════════════════════════════
NEST_PORT=5000

# Fon ishlari — 25/25 NestJS'da. `*` = hammasi.
# ⚠ Express worker'lari BIR VAQTDA ishlamasligi SHART: ikkalasi ham
# cronni ro'yxatga olsa oylik generatsiya IKKI MARTA yurardi.
NEST_WORKERS_ENABLED=true
NEST_WORKER_JOBS=*

# Telegram bot buyruqlari — endi NestJS qabul qiladi.
# ⚠ `bot_locks` qulfi oxirgi to'siq: ikkita polling nusxasi bo'lsa
# ham faqat bittasi buyruq oladi.
NEST_BOT_POLLING=true

# Ommaviy import navbatini NestJS iste'mol qiladi.
# ⚠ Bu bayroqsiz NestJS ishni navbatga QO'YADI, lekin HECH KIM olmaydi
# va import "queued" holatida ABADIY qotib qolardi.
# ⚠ `REDIS_URL` bo'sh bo'lsa navbat umuman ishlamaydi — import SINXRON.
NEST_IMPORT_WORKER=true
