# API URL
VITE_API_URL=http://localhost:5000/api

#  App Name
VITE_APP_NAME=Bayyina

# Logotip/favicon. Mahalliy fayl (`/logo.svg` -> client/public/) yoki
# to'liq manzil (`https://.../logo.png`) bo'lishi mumkin. Manzil ish
# vaqtida qo'llanadi, shuning uchun buzuq bo'lsa /logo.svg joyida qoladi.
VITE_APP_LOGO=/logo.svg

# ─────────────────────────────────────────────────────────────────────
#  Tema ranglari
#  Format: HSL kanallari, hsl() o'ramisiz -> "<tus> <to'yinganlik>% <yorug'lik>%"
#  Masalan: qora = "0 0% 0%", oq = "0 0% 100%", ko'k = "217 91% 60%"
# ─────────────────────────────────────────────────────────────────────

# LIGHT (yorug') rejim
VITE_APP_PRIMARY=33 33% 35%
VITE_APP_BACKGROUND=36 50% 98%

# DARK (qorong'i) rejim - MAJBURIY EMAS.
#
# Berilmasa: yuqoridagi ranglardan avtomatik hosil qilinadi - tus (hue)
# saqlanadi, yorug'lik esa kontrast 4.5:1 ga yetguncha oshiriladi.
#
# QORA brend rangi uchun ALOHIDA e'tibor: "0 0% 0%" ni qorong'i fonda
# ko'rsatib bo'lmaydi (qora ustida qora ko'rinmaydi), shuning uchun
# avtomatik rejim uni kulrangga aylantiradi. Brend ko'rinishini saqlash
# uchun dark variantni O'ZINGIZ kiriting:
#
#   VITE_APP_PRIMARY_DARK=36 45% 70%
#   VITE_APP_BACKGROUND_DARK=0 0% 4%
#
# Kiritilgan qiymat aynan ishlatiladi; faqat kontrast past bo'lsa
# yorug'ligi ko'tariladi (tus hech qachon o'zgarmaydi).
# VITE_APP_PRIMARY_DARK=
# VITE_APP_BACKGROUND_DARK=