// ─────────────────────── FOYDALANUVCHI VA HUQUQ ───────────────────────

model User {
  id         String    @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  firstName  String
  lastName   String
  // Autentifikatsiya kaliti — YAGONA unique maydon.
  username   String    @unique
  // DIQQAT: telefon UNIQUE EMAS — bitta raqamdan bir nechta odam (aka-uka,
  // ota-ona) foydalanadi. Mongo'dagi eski `phone_1` unique indeksi ataylab
  // ko'chirilmadi.
  phone      String?
  passwordHash String
  // Dinamik rol: Role.value ga ishora qiladi, lekin FK EMAS — tizim
  // rollari (owner/teacher/student) Role jadvalisiz ham ishlaydi.
  role       String    @default("student")

  homeBranchId String? @db.VarChar(24)
  homeBranch   Branch? @relation("UserHomeBranch", fields: [homeBranchId], references: [id])

  isActive    Boolean   @default(true)
  archivedAt  DateTime?
  lastLoginAt DateTime?
  birthDate   DateTime?
  gender      Gender?
  enrolledAt  DateTime?

  leadId String? @db.VarChar(24)
  lead   Lead?   @relation("UserFromLead", fields: [leadId], references: [id])

  completedAt       DateTime?
  completedAtManual Boolean   @default(false)
  hiredAt           DateTime?
  payrollStartFrom  DateTime?
  terminatedAt      DateTime?
  terminationReason String    @default("")

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.VarChar(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchAssignments UserBranchAssignment[]

  // ── teskari bog'lanishlar ──
  activityLogs            ActivityLog[]            @relation("ActivityLogUser")
  aiConfigsUpdated        AiConfig[]               @relation("AiConfigUpdatedBy")
  approvalsRequested      Approval[]               @relation("ApprovalRequestedBy")
  approvalsDecided        Approval[]               @relation("ApprovalDecidedBy")
  archiveLogs             ArchiveLog[]             @relation("ArchiveLogUser")
  archiveLogsPerformed    ArchiveLog[]             @relation("ArchiveLogPerformedBy")
  archiveReasonsCreated   ArchiveReason[]          @relation("ArchiveReasonCreatedBy")
  assignmentsSent         Assignment[]             @relation("AssignmentSender")
  assignmentRecipients    AssignmentRecipient[]    @relation("AssignmentRecipientStudent")
  attendances             Attendance[]             @relation("AttendanceStudent")
  attendancesRecorded     Attendance[]             @relation("AttendanceRecordedBy")
  exemptions              AttendanceExemption[]    @relation("ExemptionStudent")
  exemptionsCreated       AttendanceExemption[]    @relation("ExemptionCreatedBy")
  botUsers                BotUser[]                @relation("BotUserUser")
  cashTransfersSent       CashTransfer[]           @relation("CashTransferSentBy")
  cashTransfersReceived   CashTransfer[]           @relation("CashTransferReceivedBy")
  coursesCreated          Course[]                 @relation("CourseCreatedBy")
  coursePricesCreated     CoursePrice[]            @relation("CoursePriceCreatedBy")
  debtWriteOffs           DebtWriteOff[]           @relation("DebtWriteOffStudent")
  debtWriteOffsCreated    DebtWriteOff[]           @relation("DebtWriteOffCreatedBy")
  depositTransactions     DepositTransaction[]     @relation("DepositTxStudent")
  depositTxCreated        DepositTransaction[]     @relation("DepositTxCreatedBy")
  discounts               Discount[]               @relation("DiscountStudent")
  discountsCreated        Discount[]               @relation("DiscountCreatedBy")
  expensesCreated         Expense[]                @relation("ExpenseCreatedBy")
  expenseCategoriesCreated ExpenseCategory[]       @relation("ExpenseCategoryCreatedBy")
  feedbacksAuthored       Feedback[]               @relation("FeedbackAuthor")
  feedbacksReplied        Feedback[]               @relation("FeedbackRepliedBy")
  feedbacksReviewed       Feedback[]               @relation("FeedbackReviewedBy")
  feedbacksResolved       Feedback[]               @relation("FeedbackResolvedBy")
  grades                  Grade[]                  @relation("GradeStudent")
