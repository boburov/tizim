model TeacherSalary {
  id        String  @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId  String  @db.VarChar(24)
  branch    Branch  @relation("TeacherSalaryBranch", fields: [branchId], references: [id])
  teacherId String  @db.VarChar(24)
  teacher   User    @relation("TeacherSalaryTeacher", fields: [teacherId], references: [id])
  // NULL = markaz qatori (base/bonus/deduction/opening).
  // `onDelete: Restrict` — STANDART `SetNull` EMAS.
  //
  // `SetNull` bu yerda BAZANI O'ZINI ZIDDIYATGA solardi: guruh o'chganda
  // `groupId` null bo'ladi, `teacher_salaries_kind_group_check` esa
  // `kind='group'` qatoridan `groupId` NOT NULL bo'lishini talab qiladi.
  // Natijada guruhni o'chirish 23514 (CHECK violation) bilan yiqilardi —
  // xato esa `groups` ni o'chirish paytida, umuman boshqa jadval nomi
  // bilan chiqardi va sababi ko'rinmasdi.
  //
  // ENDI: maosh tarixi bor guruhni o'chirish 23503 (FK violation) beradi —
  // ya'ni xato AYNAN to'sayotgan jadvalni ko'rsatadi. Maosh tarixi
  // hech qachon o'chirilmaydi va o'zgartirilmaydi.
  //
  // `teacherId` allaqachon `RESTRICT` edi — bu uni guruh tomoni bilan
  // MOSLAYDI (ilgari bir tomoni himoyalangan, ikkinchisi yo'q edi).
  groupId   String? @db.VarChar(24)
  group     Group?  @relation("TeacherSalaryGroup", fields: [groupId], references: [id], onDelete: Restrict)
  kind      SalaryKind @default(group)
  year      Int
  month     Int
  salaryType SalaryRateType @default(fixed)
  fixedAmount Decimal @default(0) @db.Decimal(18, 2)
  percentRate Decimal @default(0) @db.Decimal(18, 4)
  workStartDate DateTime?
  workEndDate   DateTime?
  variableType  CompVariableType?
  variableRate  Decimal @default(0) @db.Decimal(18, 4)
  percentBase   CompPercentBase?
  rateSource    String @default("none")
  compensationId String? @db.VarChar(24)
  compensation   TeacherCompensation? @relation("TeacherSalaryComp", fields: [compensationId], references: [id])
  groupRevenue    Decimal @default(0) @db.Decimal(18, 2)
  prorationFactor Float @default(1)
  payableDays     Int   @default(0)
  totalDays       Int   @default(0)
  proratedFixed   Decimal @default(0) @db.Decimal(18, 2)
  percentAmount   Decimal @default(0) @db.Decimal(18, 2)
  studentUnits    Float @default(0)
  perStudentAmount Decimal @default(0) @db.Decimal(18, 2)
  lessonHours     Float @default(0)
  perHourAmount   Decimal @default(0) @db.Decimal(18, 2)
  perGroupAmount  Decimal @default(0) @db.Decimal(18, 2)
  baseEarnings    Decimal @default(0) @db.Decimal(18, 2)
  expectedAmount  Decimal @default(0) @db.Decimal(18, 2)
  isOpening       Boolean @default(false)
  paidAmount      Decimal @default(0) @db.Decimal(18, 2)
  overpaidAmount  Decimal @default(0) @db.Decimal(18, 2)
  status    PayStatus @default(unpaid)
  isLocked  Boolean @default(false)
  lockedAt  DateTime?
  lockedById String? @db.VarChar(24)
  lockedBy   User?   @relation("TeacherSalaryLockedBy", fields: [lockedById], references: [id])
  source    SalarySource @default(auto)
  reason    String  @default("")
  approvalId String? @db.VarChar(24)
  approval   Approval? @relation("TeacherSalaryApproval", fields: [approvalId], references: [id])
  createdById String? @db.VarChar(24)
  createdBy   User?   @relation("TeacherSalaryCreatedBy", fields: [createdById], references: [id])
  recalculatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions SalaryTransaction[] @relation("SalaryTxSalary")

  // IKKITA QISMAN UNIQUE (Mongo'dagi kabi — ular ATAYLAB ajratilgan):
  //   a) (teacherId, groupId, year, month, kind) WHERE groupId IS NOT NULL
  //   b) (teacherId, year, month, kind)          WHERE groupId IS NULL AND kind = 'base'
  // Oddiy bitta unique indeks NULL'larni teng sanamagani uchun fiksa va
  // bonus qatorlari bir oyda yonma-yon TURA OLMAY qolardi.
  @@index([branchId])
  @@index([teacherId])
  @@index([groupId])
  @@index([kind])
  @@index([isOpening])
  @@index([status])
  @@index([year, month, status])
  @@map("teacher_salaries")
}

