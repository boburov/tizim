  groupId  String? @db.VarChar(24)
  group    Group?  @relation("OpeningBalanceGroup", fields: [groupId], references: [id])
  year   Int
  month  Int
  kind   OpeningKind
  // [{ model, docId }] — materializatsiya qilingan hujjatlar izi.
  materializedRefs Json @default("[]")
