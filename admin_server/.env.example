# ===== Admin server (NestJS) =====
NODE_ENV=development
PORT=4000

# PostgreSQL (admin panel metadata bazasi)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admin_panel?schema=public"

# Admin panel frontend manzillari (vergul bilan)
ADMIN_CLIENT_URL=http://localhost:5174

# ===== Statik super admin (hozircha) =====
SUPER_ADMIN_EMAIL=admin@example.uz
# Ishlab chiqarishda bcrypt hash ishlating (pastdagi buyruq bilan yarating):
#   node -e "console.log(require('bcrypt').hashSync('parol', 10))"
SUPER_ADMIN_PASSWORD_HASH=
# Dev qulayligi uchun (HASH bo'lmasa ishlatiladi) — PRODda ishlatmang:
SUPER_ADMIN_PASSWORD=admin123

# ===== JWT / Cookie =====
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECRET=change-me-cookie

# ===== Maxfiy sozlamalarni shifrlash =====
# Tenant sozlamalari orasida Telegram bot tokeni, Gemini API kaliti kabi
# maxfiy qiymatlar bor. Ular bazada AES-256-GCM bilan shifrlanadi.
#
# Kalitsiz maxfiy sozlamalarni SAQLAB BO'LMAYDI (panel ochiq aytadi).
# Kalit yarating:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# DIQQAT: kalitni almashtirsangiz eski shifrlangan qiymatlar o'qilmaydi —
# ular "standart" holatga qaytadi va qayta kiritish kerak bo'ladi.
SETTINGS_ENCRYPTION_KEY=

# ===== API xizmatlar (edu.pronauns va h.k.) =====
# Sotiladigan API xizmatlar o'zlarining kalitlarini shu server orqali
# tekshiradi (/api/api-gateway/*). Bu marshrutlarda JWT yo'q — chaqiruvchi
# foydalanuvchi emas, xizmatning o'zi. Himoya shu umumiy sir orqali.
#
# AYNAN SHU qiymat xizmat tomonida ham API_GATEWAY_SECRET bo'lib turishi
# kerak (edu.pronauns uchun: CONTROL_PLANE_URL + API_GATEWAY_SECRET).
#
# Sir yarating:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Bo'sh qoldirilsa gateway marshrutlari 503 qaytaradi — ya'ni ochiq
# qolib ketmaydi, lekin xizmatlar ham ishlamaydi.
API_GATEWAY_SECRET=

# ===== Telegram botlar =====
# Botlar tenantlardan ALOHIDA deploy qilinadi: bazasi yo'q, client build'i
# yo'q. Node bot pm2 ostida polling qiladi (domen kerak emas), PHP bot esa
# nginx+php-fpm ortida webhook oladi.
BOT_PROVISION_SCRIPT=/root/admin/bot-provision.sh
BOT_DEPROVISION_SCRIPT=/root/admin/bot-deprovision.sh
BOTS_ROOT=/root/bots

# Webhook botlarning subdomeni shundan yasaladi: <slug>.<BOTS_BASE_DOMAIN>
#
# DNS'da BIR MARTA wildcard yozuv kerak:
#   *.bots.example.uz   A   <VPS IP>
# Shundan keyin har yangi bot uchun DNS'ga tegish shart emas — certbot
# har subdomen uchun HTTP-01 orqali oddiy sertifikat oladi (wildcard
# SERTIFIKAT kerak emas, u DNS-01 talab qilardi).
#
# Bo'sh qoldirilsa PHP (webhook) bot yaratib bo'lmaydi — panel ochiq aytadi.
BOTS_BASE_DOMAIN=

# Bot portlari — tenant diapazoniga TEGMASLIGI shart, aks holda ikkalasi
# bitta portni band qilishi mumkin.
BOT_PORT_MIN=7000
BOT_PORT_MAX=7999

# PHP-FPM soketi (PHP botlar uchun). Versiyani serveringizdagiga moslang:
#   ls /run/php/
PHP_FPM_SOCK=/run/php/php8.2-fpm.sock

# ===== Provisioning (VPS) =====
# provision.sh skript yo'li va ishchi papka
PROVISION_SCRIPT=/root/admin/provision.sh
PROVISION_CWD=/root/admin
# reconfigure.sh — sozlama o'zgarishini ishlab turgan tenantga yetkazadi
# (papkani tozalamaydi: baza, fayllar va git tarixi joyida qoladi)
RECONFIGURE_SCRIPT=/root/admin/reconfigure.sh
# Tenant PostgreSQL manzilining asosi — tenant .env dagi DATABASE_URL shundan
# quriladi (`${POSTGRES_BASE_URL}/${tenant.dbName}?schema=public`).
# provision.sh va deprovision.sh ham AYNI shu o'zgaruvchini o'qiydi.
POSTGRES_BASE_URL=postgresql://postgres:postgres@127.0.0.1:5432
# Baza YARATISH/O'CHIRISH uchun ulanadigan boshqaruv bazasi
POSTGRES_ADMIN_DB=postgres
# Admin API ning TASHQI manzili. Tenant serverlar heartbeat shunga yuboradi,
# tenant repolaridagi GitHub Action ham deploy so'rovini shu manzilga qiladi.
# Bo'sh bo'lsa tenant repolarida avto-deploy workflow'i yaratilmaydi.
ADMIN_API_PUBLIC_URL=https://admin.example.uz/api
# DNS uchun beriladigan public IP (bitta VPS bo'lsa doim shu IP)
SERVER_PUBLIC_IP=203.0.113.10
# Tenant serverlariga ajratiladigan port diapazoni
TENANT_PORT_MIN=5100
TENANT_PORT_MAX=5999
# study-center shabloni papkasi (seed uchun)
STUDY_CENTER_TEMPLATE_DIR=/root/templates/study-center

# ===== GitHub (har tenant uchun alohida repo) =====
# Yoqilsa, har yangi loyiha uchun alohida repositoriy ochiladi va kod
# VPS'dan o'sha repoga yuboriladi. `.env` fayllari repoga HECH QACHON
# tushmaydi — push oldidan alohida tekshiriladi.
#
# Ikkala kalit ham BO'SH bo'lsa integratsiya butunlay o'chiq bo'ladi
# (provisioning avvalgidek ishlayveradi, faqat repo yaratilmaydi).
#
# Token huquqlari:
#   Classic PAT     — `repo` (va repo o'chirish kerak bo'lsa `delete_repo`)
#   Fine-grained    — Administration: RW, Contents: RW, Secrets: RW
GITHUB_TOKEN=
GITHUB_OWNER=
# "user" (shaxsiy hisob) yoki "org" (tashkilot)
GITHUB_OWNER_TYPE=user
# Repo nomi oldiga qo'shiladi, masalan "lc-" -> lc-tenant-bilim-a3f9c210
GITHUB_REPO_PREFIX=
# Repo yopiqmi. "false" qilishdan oldin o'ylang: mijoz kodi ochiq bo'ladi.
GITHUB_REPO_PRIVATE=true
# Loyiha o'chirilganda repo ham o'chirilsinmi.
# Standart false — repo ARXIVLANADI, ya'ni mijoz kodi va tarixi saqlanib
# qoladi. true qilsangiz tarix qaytarib bo'lmas tarzda yo'qoladi.
GITHUB_DELETE_REPO_ON_DEPROVISION=false

# ===== Google OAuth (mijozlar uchun) =====
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Application type: Web application
#
# MUHIM: quyidagi "Authorized redirect URI" AYNAN GOOGLE_CALLBACK_URL bilan
# bir xil bo'lishi shart, aks holda "redirect_uri_mismatch" xatosi chiqadi:
#   http://localhost:4000/api/customer/auth/google/callback
#
# Bu ikkala kalit BO'SH bo'lsa Google orqali kirish o'chiq bo'ladi
# (server ishlaydi, /customer/auth/google esa 503 qaytaradi).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/customer/auth/google/callback
