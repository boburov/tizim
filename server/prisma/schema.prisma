model Expense {
  id          String  @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId    String? @db.VarChar(24)
  branch      Branch? @relation("ExpenseBranch", fields: [branchId], references: [id])
  allocation  ExpenseAllocation @default(none)
  categoryId  String  @db.VarChar(24)
  category    ExpenseCategory @relation("ExpenseCategoryRel", fields: [categoryId], references: [id])
  categoryName String @default("")
  categoryKind String @default("operating")
  title       String
  description String  @default("")
  amount      Decimal @db.Decimal(18, 2)
  currency    ExpenseCurrency @default(UZS)
  originalAmount Decimal? @db.Decimal(18, 2)
  exchangeRate   Decimal? @db.Decimal(18, 4)
  rateSource     String @default("")
  spentAt     DateTime
  accrualYear Int
  accrualMonth Int
  method      ExpenseMethod @default(cash)
  vendor      String  @default("")
  receiptId   String? @db.VarChar(24)
  receipt     StoredFile? @relation("ExpenseReceipt", fields: [receiptId], references: [id])
  isCapital   Boolean @default(false)
  depreciationMonths Int?

  // ── FAZA 8: DOIMIY / O'ZGARUVCHAN ──
  // NULL = kategoriyaning standartidan meros (ExpenseCategory.costType).
  // Ochiq qiymat faqat ISTISNO uchun: masalan bir martalik reklama
  // kampaniyasi doimiy "Marketing" kategoriyasida turgan bo'lsa.
  // Tahlilda: COALESCE(expense.costType, category.costType).
  costType    CostType?

  // ── FAZA 2: MAS'UL SHAXS / YETKAZIB BERUVCHI ──
  // `vendor` (matn) QOLADI — tashqi yetkazib beruvchi ko'pincha tizimda
  // umuman yo'q. Bu esa ICHKI odam: kim pul oldi/sarfladi.
  personId    String? @db.VarChar(24)
  person      User?   @relation("ExpensePerson", fields: [personId], references: [id])

  // ── FAZA 9: qaysi takrorlanuvchi shablondan tug'ilgan ──
  recurringExpenseId String? @db.VarChar(24)
  recurringExpense   RecurringExpense? @relation("RecurringExpenseChild", fields: [recurringExpenseId], references: [id])
  expenseApprovalId String? @db.VarChar(24)
  expenseApproval   Approval? @relation("ExpenseApproval", fields: [expenseApprovalId], references: [id])
  createdById String? @db.VarChar(24)
  createdBy   User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.VarChar(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // QISMAN UNIQUE: (expenseApprovalId) WHERE expenseApprovalId IS NOT NULL
  recurringOccurrence RecurringExpenseOccurrence? @relation("OccurrenceExpense")
  @@index([spentAt, isDeleted])
  @@index([accrualYear, accrualMonth, categoryId])
  @@index([branchId, spentAt])
  @@index([categoryId])
  @@index([isCapital])
  @@map("expenses")
}

