// Admin panel ma'lumotlar bazasi (PostgreSQL orqali Prisma).
// Bu baza faqat provisioning metadata'sini saqlaydi. Har tenant esa
// o'z alohida MongoDB bazasida ishlaydi (tenant server mongoose'da).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 2-darajali admin userlar. Super admin .env orqali (statik) kiradi,
// bu jadval keyinchalik qo'shiladigan userlar uchun (role bilan).
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

// Tenant hayot sikli
enum TenantStatus {
  DRAFT // yozuv yaratildi, hali provision qilinmagan
  PROVISIONING // provision.sh ishlayapti
  ACTIVE // ishga tushdi
  FAILED // provisioning xatosi
  SUSPENDED // to'xtatilgan (limit oshgan yoki to'lov yo'q)
  DEPROVISIONING // deprovision.sh ishlayapti
  DELETED // VPS resurslari o'chirilgan, yozuv arxiv sifatida qoldi
}

// Tenant kodining GitHub repodagi holati.
enum GitStatus {
  DISABLED // GitHub integratsiyasi o'chiq (token yo'q yoki tenant uchun o'chirilgan)
  PENDING // repo hali yaratilmagan
  CREATING // GitHub API'da repo ochilyapti
  PUSHING // VPS'dan kod yuborilyapti
  SYNCED // repo bor va oxirgi push muvaffaqiyatli
  FAILED // repo yaratish yoki push xatosi
}

// Sozlama o'zgarishini tenantga yetkazish holati.
enum ApplyStatus {
  IDLE // kutilayotgan o'zgarish yo'q
  PENDING // o'zgarish saqlangan, hali qo'llanmagan
  APPLYING // reconfigure.sh ishlayapti
  FAILED // qo'llashda xato
}

// "Tizim" turi — dinamik. Hozircha "oquv markaz", keyin boshqalar qo'shiladi.
// Har template qaysi client/server shablonidan nusxa olinishini belgilaydi.
model SystemTemplate {
  id          String   @id @default(cuid())
  key         String   @unique // masalan "study-center"
  name        String // ko'rinadigan nom, masalan "O'quv markaz tizimi"
  description String?
  // Provisioning skript template papkalari (VPS'dagi manba yo'llari)
  templateDir String   @default("/root/templates/study-center")
  // Bu tizim faol tanlash uchun ochiqmi
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants Tenant[]
}

model Tenant {
  id String @id @default(cuid())

  // Foydalanuvchi kiritadigan brend ma'lumotlari.
  //
  // Ranglar HEX ko'rinishida saqlanadi (rang tanlagich shu formatda ishlaydi),
  // client .env ga yozishdan oldin HSL kanallariga aylantiriladi — tenant
  // client `parseHsl` faqat "33 33% 35%" formatini o'qiydi.
  name       String // markaz nomi (VITE_APP_NAME)
  domain     String  @unique // masalan markaz.example.uz
  brandColor String  @default("#4f46e5") // VITE_APP_PRIMARY (light)
  logoUrl    String? // VITE_APP_LOGO
  botToken   String? // TELEGRAM_BOT_TOKEN (shifrlangan holda saqlanadi)

  // Qolgan brend ranglari — ixtiyoriy. Berilmasa tenant client ularni
  // brandColor'dan avtomatik hosil qiladi (tus saqlanadi, kontrast ta'minlanadi).
  brandBackground     String? // VITE_APP_BACKGROUND
  brandColorDark      String? // VITE_APP_PRIMARY_DARK
  brandBackgroundDark String? // VITE_APP_BACKGROUND_DARK

  // NOYOB DB nomi — hech qachon takrorlanmaydi (slug + qisqa cuid).
  // Bu tenant MongoDB bazasining nomi bo'ladi.
  dbName String @unique

  // Ajratilgan PM2 process nomi va port
  pm2Name String @unique
  port    Int    @unique

  // DNS uchun beriladigan IP (bitta VPS bo'lsa doim bir xil)
  serverIp String?

  status        TenantStatus @default(DRAFT)
  provisionLog  String?      @db.Text // provision.sh chiqishi (oxirgi)
  failureReason String?

  // Deprovision (o'chirish) kuzatuvi
  deprovisionLog String?   @db.Text
  deletedAt      DateTime?

  // Tenant server bilan aloqa (heartbeat) — noyob sirli kalit
  heartbeatSecret String?   @unique
  lastHeartbeatAt DateTime?

  // --- GitHub: har tenant kodi o'z repositoriysida ---
  gitStatus    GitStatus @default(PENDING)
  repoFullName String?   @unique // "owner/tenant-bilim-a3f9c210"
  repoUrl      String? // https://github.com/owner/repo
  repoPrivate  Boolean   @default(true)
  repoError    String?
  gitLog       String?   @db.Text // oxirgi push chiqishi
  lastPushedAt DateTime?

  // Tenant repodagi GitHub Action shu token bilan admin serverga murojaat
  // qiladi va o'zini qayta deploy qildiradi. VPS SSH kaliti repolarga
  // TARQATILMAYDI — bitta repo sizib chiqsa ham faqat SHU tenant zarar ko'radi.
  deployToken String? @unique

  // --- Sozlamalar (.env) boshqaruvi ---
  settings TenantSetting[]

  // Oxirgi MUVAFFAQIYATLI qo'llangan konfiguratsiya surati.
  // Kutilayotgan o'zgarish = hozirgi hisoblangan konfiguratsiya bilan farq.
  // Maxfiy qiymatlar bu yerda ochiq emas — sha256 hash sifatida yoziladi,
  // shunda "o'zgardimi" savoliga javob bor, sir esa ikki joyda yotmaydi.
  appliedConfig Json?
  applyStatus   ApplyStatus @default(IDLE)
  applyLog      String?     @db.Text
  applyError    String?
  lastAppliedAt DateTime?

  systemTemplate   SystemTemplate @relation(fields: [systemTemplateId], references: [id])
  systemTemplateId String

  // Self-service: bu tenant qaysi mijozga tegishli (super admin yaratsa null)
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  subscription   Subscription?
  usageSnapshots UsageSnapshot[]
  addons         TenantAddon[]
  apiConsumers   ApiConsumer[]

  createdBy String? // qaysi admin yaratdi (email)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

// Tenantning .env sozlamasi — FAQAT standartdan farq qiladigan qiymatlar.
//
// Sozlamalar ro'yxati (kalit, tur, standart qiymat, validatsiya, qo'llash
// rejimi) admin_server kodidagi registrda turadi: `settings/settings.registry.ts`.
// Bu yerda faqat mijoz o'zgartirgan qiymat saqlanadi — shunda registrda
// standart qiymat yangilansa, uni o'zgartirmagan barcha tenantlar yangisini
// avtomatik oladi.
model TenantSetting {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  key      String // registrdagi kalit, masalan "GEMINI_API_KEY"

  // Maxfiy sozlama (`secret` turi) shifrlangan holda yotadi: "v1:iv:tag:data".
  // Ochiq sozlama shundayligicha. Farqni `isSecret` bildiradi.
  value    String  @db.Text
  isSecret Boolean @default(false)

  updatedBy String? // qaysi admin o'zgartirdi (email)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String?
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============================================================================
// SELF-SERVICE: mijozlar (AdminUser'dan ALOHIDA — bular to'lov qiladigan
// tashqi foydalanuvchilar, AdminUser esa bizning xodimlarimiz).
// ============================================================================

model Customer {
  id String @id @default(cuid())

  email String @unique
  // Google orqali kirgan mijozda parol YO'Q — shuning uchun optional.
  // Parol bilan kirishga urinishda null bo'lsa rad etiladi.
  passwordHash String?
  fullName     String?
  phone        String?
  companyName  String?

  // --- Google OAuth ---
  // googleId bo'lsa — bu hisob Google bilan bog'langan.
  googleId  String? @unique
  avatarUrl String?

  emailVerified Boolean   @default(false)
  verifyToken   String?   @unique // email tasdiqlash tokeni
  resetToken    String?   @unique // parol tiklash tokeni
  resetTokenExp DateTime?

  isActive Boolean @default(true)

  tenants       Tenant[]
  subscriptions Subscription[]
  transactions  Transaction[]
  apiConsumers  ApiConsumer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// TARIFLAR VA IMKONIYATLAR (entitlements)
// ============================================================================

enum BillingCycle {
  MONTHLY
  YEARLY
  LIFETIME
}

// Feature ikki xil bo'ladi:
//   LIMIT   — raqamli chek (masalan max_users = 1000)
//   BOOLEAN — yoqilgan/o'chirilgan (masalan telegram_bot)
enum FeatureType {
  LIMIT
  BOOLEAN
}

// Dinamik imkoniyatlar ro'yxati. Yangi xizmat qo'shilsa (Telegram bot, SMS)
// shu yerga yangi yozuv qo'shiladi — kod o'zgartirilmaydi.
model Feature {
  id          String      @id @default(cuid())
  key         String      @unique // "max_users", "telegram_bot", "max_storage_mb"
  name        String
  description String?
  type        FeatureType @default(LIMIT)
  unit        String? // "ta", "MB" — UI da ko'rsatish uchun
  // Bu feature usage orqali kuzatiladimi (heartbeat metrikasi bilan bog'liqmi)
  metricKey   String? // masalan "user_count" — UsageSnapshot bilan bog'lash
  isActive    Boolean     @default(true)

  planFeatures PlanFeature[]
  addons       Addon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id          String       @id @default(cuid())
  key         String       @unique // "free", "basic", "pro"
  name        String
  description String?
  price       Decimal      @default(0) @db.Decimal(12, 2)
  currency    String       @default("UZS")
  interval    BillingCycle @default(MONTHLY)
  trialDays   Int          @default(0)
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  isPublic    Boolean      @default(true) // client panelda ko'rinadimi

  features      PlanFeature[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tarif ichidagi konkret limit/imkoniyat qiymati.
// value: LIMIT uchun son (1000), BOOLEAN uchun 0/1. -1 = cheksiz.
model PlanFeature {
  id        String  @id @default(cuid())
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId    String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId String
  value     Int

  @@unique([planId, featureId])
  @@index([featureId])
}

// Alohida sotib olinadigan qo'shimcha xizmat (add-on).
model Addon {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  price       Decimal  @default(0) @db.Decimal(12, 2)
  currency    String   @default("UZS")
  // Qaysi feature'ni yoqadi/oshiradi
  feature     Feature? @relation(fields: [featureId], references: [id])
  featureId   String?
  value       Int      @default(1) // feature qiymatiga qo'shiladi
  isActive    Boolean  @default(true)

  tenantAddons TenantAddon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantAddon {
  id        String    @id @default(cuid())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  addon     Addon     @relation(fields: [addonId], references: [id], onDelete: Cascade)
  addonId   String
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([tenantId, addonId])
}

// ============================================================================
// OBUNA VA TO'LOV
// ============================================================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE // muddat o'tdi, hali to'lanmadi (grace period)
  CANCELED
  EXPIRED
}

model Subscription {
  id         String    @id @default(cuid())
  // Bitta tenantda bitta faol obuna
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String    @unique
  plan       Plan      @relation(fields: [planId], references: [id])
  planId     String
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  status           SubscriptionStatus @default(TRIALING)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime?
  canceledAt       DateTime?

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([planId])
}

enum PaymentProvider {
  PAYME
  CLICK
  MANUAL // qo'lda (naqd/bank o'tkazma) — admin tasdiqlaydi
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
  FAILED
}

model Transaction {
  id             String        @id @default(cuid())
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerId     String?

  amount   Decimal         @db.Decimal(12, 2)
  currency String          @default("UZS")
  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  // Provayder tomonidagi tranzaksiya id (Payme/Click) — idempotentlik uchun
  providerTxnId String?
  rawPayload    String?   @db.Text
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerTxnId])
  @@index([status])
  @@index([customerId])
}

// ============================================================================
// USAGE (heartbeat orqali tenant serverdan keladi)
// ============================================================================

// Har heartbeat bitta snapshot yozadi — tarix uchun (grafik chizish mumkin).
model UsageSnapshot {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  metricKey  String // "user_count", "student_count", "storage_mb"
  value      Int
  recordedAt DateTime @default(now())

  @@index([tenantId, metricKey, recordedAt])
}

// ============================================================================
// API XIZMATLAR (edu.pronauns va h.k.) — kalit bilan sotiladigan mahsulotlar
//
// Bu yuqoridagi Plan/Subscription'dan ATAYLAB alohida. U yerda mijoz = tenant
// (o'quv markaz), bu yerda mijoz = API kaliti bilan murojaat qiladigan ilova.
// Limitlar ham boshqacha: u yerda "nechta o'quvchi", bu yerda "sekundiga
// nechta so'rov".
//
// admin_server = CONTROL PLANE (tarif, muddat, kalit, hisob).
// Xizmatning o'zi (python) = DATA PLANE: kalitni shu yerdan so'rab oladi,
// keshlaydi va limitni O'ZI majburlaydi — shunda har so'rovda tarmoqqa
// chiqilmaydi va admin server o'chsa ham xizmat darrov to'xtamaydi.
// ============================================================================

enum ApiSubscriptionStatus {
  ACTIVE // ishlaydi
  SUSPENDED // admin qo'lda to'xtatdi (to'lov yo'q, suiiste'mol)
  EXPIRED // muddati o'tdi (avtomatik qo'yiladi)
  CANCELED // mijoz voz kechdi
}

// Sotiladigan API xizmat. Birinchisi — "edu-pronauns" (talaffuz baholash).
model ApiService {
  id          String  @id @default(cuid())
  key         String  @unique // "edu-pronauns"
  name        String
  description String?
  baseUrl     String? // https://speech.sevenedu.org
  docsUrl     String?
  isActive    Boolean @default(true)

  tiers         ApiTier[]
  subscriptions ApiSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tarif pog'onasi. Bu yerdagi raqamlarni data plane AYNAN o'sha holicha
// majburlaydi — shuning uchun tarifni o'zgartirish = xizmat tezligini
// o'zgartirish, kod tegilmaydi.
//
// NEGA "tezlik" = slot + rpm + ustuvorlik: inference narxi qat'iy (bitta
// so'rov ~100 ms CPU'da), bir xil temirda bitta so'rovni tezlashtirib
// bo'lmaydi. Yuqori tarif ko'proq parallel slot va navbatda oldinlik oladi —
// yuklama ostida u haqiqatan 2x/4x ko'p ish bajaradi.
model ApiTier {
  id        String     @id @default(cuid())
  service   ApiService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String
  key       String // "basic", "pro", "max"
  name      String

  price    Decimal      @default(0) @db.Decimal(12, 2)
  currency String       @default("USD")
  interval BillingCycle @default(MONTHLY)

  // --- majburlanadigan qiymatlar ---
  concurrency  Int @default(1) // bir vaqtda nechta so'rov ishlaydi
  rateLimitRpm Int @default(60) // daqiqasiga nechta so'rov
  priority     Int @default(3) // navbatdagi o'rin, 1 = eng oldin
  monthlyQuota Int @default(-1) // oyiga nechta so'rov, -1 = cheksiz

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  subscriptions ApiSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, key])
}

// API mijozi. Mustaqil yozuv — Customer yoki Tenant'ga bog'lash IXTIYORIY,
// shunda o'z kompaniyamizga ham, tashqi mijozga ham bir xil kalit beriladi.
model ApiConsumer {
  id    String  @id @default(cuid())
  label String // "SevenEdu (o'zimiz)"
  email String?
  note  String?

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  tenantId   String?

  isActive Boolean @default(true)

  subscriptions ApiSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([tenantId])
}

// Bitta mijozning bitta xizmatga obunasi = tarif + muddat.
model ApiSubscription {
  id         String      @id @default(cuid())
  consumer   ApiConsumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  consumerId String
  service    ApiService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId  String
  tier       ApiTier     @relation(fields: [tierId], references: [id])
  tierId     String

  status     ApiSubscriptionStatus @default(ACTIVE)
  startedAt  DateTime              @default(now())
  // null = muddatsiz. O'tgan sana = xizmat to'xtaydi (grace period yo'q).
  expiresAt  DateTime?
  canceledAt DateTime?

  keys  ApiKey[]
  usage ApiUsageDaily[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consumerId, serviceId])
  @@index([status])
}

// API kaliti. To'liq kalit BAZADA SAQLANMAYDI — faqat prefiksi (qidiruv uchun)
// va sha256 hash'i. Baza dumpi sizib chiqsa ham kalitlar bilan xizmatga
// kirib bo'lmaydi.
//
// Format: "pk_<8 belgi>.<43 belgi sir>" — nuqtagacha bo'lgan qism prefix.
model ApiKey {
  id             String          @id @default(cuid())
  subscription   ApiSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String

  prefix String  @unique // "pk_a1b2c3d4" — UI da ko'rsatiladi, lookup indeksi
  hash   String // sha256(prefix + "." + secret)
  label  String?

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdBy  String? // qaysi admin yaratdi (email)

  createdAt DateTime @default(now())

  @@index([subscriptionId])
}

// So'rovlarning kunlik yig'indisi. Har so'rov alohida qator bo'lsa jadval
// tez shishadi — data plane lokalda sanaydi va har 15 soniyada shu yerga
// qo'shib yuboradi.
model ApiUsageDaily {
  id             String          @id @default(cuid())
  subscription   ApiSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String
  day            DateTime        @db.Date
  endpoint       String          @default("assess")

  ok       Int @default(0) // muvaffaqiyatli
  rejected Int @default(0) // limit/muddat sababli rad etilgan (402/403/429)
  failed   Int @default(0) // xizmat xatosi (5xx)
  // Umumiy ishlov vaqti — o'rtacha latency shundan hisoblanadi.
  // Kuniga chegara ~1.9M so'rov x 200 ms = 380M, Int (2.1 mlrd) yetadi.
  totalMs  Int @default(0)

  @@unique([subscriptionId, day, endpoint])
  @@index([subscriptionId, day])
}
