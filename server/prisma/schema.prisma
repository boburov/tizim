model TeacherSalary {
  id        String  @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId  String  @db.VarChar(24)
  branch    Branch  @relation("TeacherSalaryBranch", fields: [branchId], references: [id])
