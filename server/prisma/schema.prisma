  thresholdAtRequest Float?
  payload  Json   @default("{}")
  // QISMAN UNIQUE: bitta subject bo'yicha bir vaqtda faqat bitta
  // `pending` so'rov bo'lishi mumkin.
  subjectKey  String?
  subjectName String @default("")
  contextName String @default("")
  status   ApprovalStatus @default(pending)
  requestedById String @db.VarChar(24)
  requestedBy   User   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  requestNote String @default("")
  decidedById String? @db.VarChar(24)
  decidedBy   User?   @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  decisionNote String @default("")
  resultTransactionId String? @db.VarChar(24)
  executedAt  DateTime?
  failureReason String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depositTransactions DepositTransaction[]     @relation("DepositTxApproval")
  expenses            Expense[]                @relation("ExpenseApproval")
  salaryTransactions  SalaryTransaction[]      @relation("SalaryTxApproval")
  staffSalaryTx       StaffSalaryTransaction[] @relation("StaffSalaryTxApproval")
  teacherSalaries     TeacherSalary[]          @relation("TeacherSalaryApproval")

  @@index([branchId, status, createdAt])
  @@index([requestedById, createdAt])
  @@index([category, status, createdAt])
  @@index([kind])
  @@map("expense_approvals")
}

