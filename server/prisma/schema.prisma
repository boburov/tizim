  stats      Json @default("{}")
  openHigh          Int @default(0)
  openMedium        Int @default(0)
  openOpportunities Int @default(0)
  error         String @default("")
  engineVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mongo'da 90 kunlik TTL indeks edi → ttlCleanup.job.js.
  @@index([branchId, startedAt])
  @@index([status])
  @@index([startedAt])
  @@map("ai_runs")
}

model AiUsageLog {
  id       String  @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId String? @db.VarChar(24)
  branch   Branch? @relation("AiUsageBranch", fields: [branchId], references: [id])
  monthKey String
  provider AiUsageProvider
  model    String
  kind     AiUsageKind
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  costUsd      Float @default(0)
  latencyMs    Int   @default(0)
  ok           Boolean @default(true)
  errorCode    String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mongo'da 400 kunlik TTL indeks edi → ttlCleanup.job.js.
  @@index([branchId])
  @@index([monthKey, ok])
  @@index([kind])
  @@index([ok])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOLIYA: TAKRORLANUVCHI CHIQIMLAR (Faza 9)
// ═══════════════════════════════════════════════════════════════════════════
//
// ── ENG MUHIM QAROR: KUTILAYOTGAN ≠ TO'LANGAN ──
//
// Vasvasa shu edi: har oy avtomatik `Expense` yaratib qo'yish. Bu
// JIMGINA YOLG'ON bo'lardi — ijara hali to'lanmagan bo'lsa ham hisobotda
// "8 mln chiqim" turardi, kassa qoldig'i esa boshqa raqam ko'rsatardi.
// Oy oxirida ikkalasi farq qilardi va sababi topilmasdi.
//
// Shuning uchun IKKI JADVAL:
//   RecurringExpense           — SHABLON ("har oy 8 mln ijara")
//   RecurringExpenseOccurrence — KUTILAYOTGAN qator ("2026-avgust, 8 mln")
//   Expense                    — HAQIQIY to'lov (faqat pul chiqqanda)
//
// Occurrence `paid` ga O'ZI o'tmaydi. Odam to'lovni tasdiqlaganda
// Expense yaratiladi va occurrence unga bog'lanadi.
//
// NEGA `Expense` GA `status` USTUNI QO'SHILMADI: mavjud hisobotlarning
// HAMMASI `Expense` ni "to'langan" deb o'qiydi. Status qo'shilsa, har bir
// so'rovga `status = 'paid'` sharti qo'shilishi kerak bo'lardi — bittasi
// unutilsa, rejalashtirilgan chiqim haqiqiy chiqim bo'lib ko'rinardi.
// Alohida jadval bu xavfni BUTUNLAY yo'q qiladi: eski so'rovlar
// kutilayotgan qatorni umuman KO'RMAYDI.

model RecurringExpense {
  id       String  @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  // NULL = markaz umumiy (filialga taqsimlanmagan) — Expense bilan bir xil qoida.
  branchId String? @db.VarChar(24)
  branch   Branch? @relation("RecurringExpenseBranch", fields: [branchId], references: [id])
  categoryId String @db.VarChar(24)
  category   ExpenseCategory @relation("RecurringExpenseCategory", fields: [categoryId], references: [id])

  title       String
  description String @default("")

  // KUTILAYOTGAN summa. Haqiqiy to'lov undan farq qilishi MUMKIN
  // (kommunal har oy o'zgaradi) — shuning uchun nomi `expected`.
  expectedAmount Decimal @default(0) @db.Decimal(18, 2)
  currency       ExpenseCurrency @default(UZS)
  method         ExpenseMethod   @default(cash)
  vendor         String @default("")
  personId       String? @db.VarChar(24)
  person         User?   @relation("RecurringExpensePerson", fields: [personId], references: [id])
  // Takrorlanuvchi chiqim odatda DOIMIY (ijara, obuna) — shuning uchun
  // standart `fixed`, Expense'dagi `variable` dan farqli.
  costType       CostType @default(fixed)

  interval      RecurringInterval @default(monthly)
  // Har N oralig'ida (2 = har ikki oyda). Standart 1.
  intervalCount Int @default(1)
  // Oyning nechanchi kuni (oylik/kvartal/yillik uchun). NULL = startDate kuni.
  dayOfMonth    Int?

  startDate DateTime
  endDate   DateTime?
  // KEYINGI KUTILAYOTGAN sana. Generator shu ustunga qarab ishlaydi va
  // uni oldinga suradi — ya'ni ikki marta yaratish mumkin emas
  // (occurrence'da (recurringExpenseId, dueDate) unique ham bor).
  nextDueAt DateTime?
  lastGeneratedAt DateTime?

  // false → qatorlar avtomatik yaratilmaydi, faqat qo'lda.
  autoGenerate Boolean @default(true)
  isActive     Boolean @default(true)
  note         String  @default("")

  createdById String? @db.VarChar(24)
  createdBy   User?   @relation("RecurringExpenseCreatedBy", fields: [createdById], references: [id])

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.VarChar(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences RecurringExpenseOccurrence[] @relation("OccurrenceTemplate")
  expenses    Expense[]                    @relation("RecurringExpenseChild")

  @@index([branchId, isActive])
  @@index([nextDueAt, isActive])
  @@index([categoryId])
  @@map("recurring_expenses")
}

model RecurringExpenseOccurrence {
  id String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  recurringExpenseId String @db.VarChar(24)
  recurringExpense   RecurringExpense @relation("OccurrenceTemplate", fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  // Shablondan nusxalanadi — filial bo'yicha filtrlash uchun
  // (har safar shablonga join qilmaslik uchun).
  branchId String? @db.VarChar(24)
  branch   Branch? @relation("OccurrenceBranch", fields: [branchId], references: [id])

  dueDate     DateTime
  periodYear  Int
  periodMonth Int
  expectedAmount Decimal @default(0) @db.Decimal(18, 2)

  status RecurringOccurrenceStatus @default(pending)

  // TO'LANGANDA yaratilgan HAQIQIY chiqim. `@unique` — bitta kutilayotgan
  // qatorga ikki marta chiqim biriktirib bo'lmaydi (ikki baravar hisob).
  expenseId String? @unique @db.VarChar(24)
  expense   Expense? @relation("OccurrenceExpense", fields: [expenseId], references: [id])
  paidAt     DateTime?
  paidAmount Decimal  @default(0) @db.Decimal(18, 2)

  note String @default("")
  createdById String? @db.VarChar(24)
  createdBy   User?   @relation("OccurrenceCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // IDEMPOTENTLIK: generator ikki marta ishlasa ham (cron qayta urinishi,
  // qo'lda chaqiruv) bir xil sana uchun ikkinchi qator YARATILMAYDI.
  @@unique([recurringExpenseId, dueDate])
  @@index([status, dueDate])
  @@index([branchId, periodYear, periodMonth])
  @@map("recurring_expense_occurrences")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOLIYA: BYUDJET (Faza 10)
// ═══════════════════════════════════════════════════════════════════════════
//
// Byudjet — REJA. Fakt esa jurnaldan/chiqimlardan keladi. Ikkalasi
// BIR JADVALDA saqlanmaydi: reja o'zgarmas hujjat, fakt esa har kuni
// o'sadi. Taqqoslash hisoblash paytida bo'ladi (analytics qatlami).

model Budget {
  id       String  @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  name     String  @default("")
  // NULL = butun markaz bo'yicha byudjet.
  branchId String? @db.VarChar(24)
  branch   Branch? @relation("BudgetBranch", fields: [branchId], references: [id])

  periodType BudgetPeriodType @default(month)
  year       Int
  // TEGISHLI BO'LMAGANDA 0 (NULL EMAS). Sabab: Postgres'da NULL != NULL,
  // ya'ni nullable ustun unique indeksda dublikatni TO'SMAYDI. 0 bilan
  // "yillik byudjet" qatori takrorlanmasligi kafolatlanadi.
  month      Int @default(0)
  quarter    Int @default(0)

  status BudgetStatus @default(draft)
  note   String @default("")

  createdById String? @db.VarChar(24)
  createdBy   User?   @relation("BudgetCreatedBy", fields: [createdById], references: [id])

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.VarChar(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines BudgetLine[] @relation("BudgetLines")

  // QISMAN UNIQUE (migratsiyada, xom SQL — Account'dagi bilan bir xil
  // sabab: branchId NULL bo'lganda Postgres dublikatni to'smaydi):
  //   a) (branchId, periodType, year, month, quarter) WHERE branchId IS NOT NULL AND isDeleted = false
  //   b) (periodType, year, month, quarter)           WHERE branchId IS NULL     AND isDeleted = false
  @@index([year, month])
  @@index([branchId, status])
  @@map("budgets")
}

model BudgetLine {
  id       String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  budgetId String @db.VarChar(24)
  budget   Budget @relation("BudgetLines", fields: [budgetId], references: [id], onDelete: Cascade)

  // UCH XIL DARAJA bitta jadvalda:
  //   total    → butun davr uchun shift (kategoriyasiz)
  //   category → aniq kategoriya (categoryId)
  //   kind     → kategoriya TURI (payroll / operating / tax / capital)
  // Uchalasi bir vaqtda bo'lishi mumkin: "jami 50 mln, shundan
  // marketing 5 mln". Tahlil qatlami darajalarni aralashtirmasligi kerak.
  scope BudgetLineScope @default(category)

  categoryId String? @db.VarChar(24)
  category   ExpenseCategory? @relation("BudgetLineCategory", fields: [categoryId], references: [id])
  categoryKind ExpenseCategoryKind?

  amount Decimal @default(0) @db.Decimal(18, 2)
  note   String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
  @@index([categoryId])
  @@map("budget_lines")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOLIYA: QAYTARIM (Faza 6)
// ═══════════════════════════════════════════════════════════════════════════
//
// ── QOIDA: ASL TO'LOV HECH QACHON TAHRIRLANMAYDI ──
//
// 700 000 to'lov qilingan, keyin 300 000 qaytarilgan bo'lsa — tarixda
// IKKALA amal ham turishi shart. `amount` ni 400 000 ga o'zgartirish
// eng oson yo'l edi va aynan shuning uchun xavfli: kassada 700 000
// kirim va 300 000 chiqim BO'LGAN, hujjatda esa faqat 400 000
// ko'rinardi — kassa sanog'i hisobotga to'g'ri kelmasdi va sababi
// izsiz yo'qolardi.
//
// ── NEGA `StudentPayment.paidAmount` KAMAYTIRILMAYDI ──
// Qaytarim — PUL harakati, o'quvchining MAJBURIYATI emas. Kursni tark
// etgan o'quvchiga pul qaytarilsa, uning qarzi TIKLANMASLIGI kerak.
// Agar to'lovning o'zi xato yozilgan bo'lsa — bu boshqa holat va
// boshqa oqim: tranzaksiyani bekor qilish (`transaction.remove`), u
// paidAmount ni qaytaradi.

model Refund {
  id       String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  branchId String @db.VarChar(24)
  branch   Branch @relation("RefundBranch", fields: [branchId], references: [id])
  studentId String @db.VarChar(24)
  student   User   @relation("RefundStudent", fields: [studentId], references: [id])
  groupId   String? @db.VarChar(24)
  group     Group?  @relation("RefundGroup", fields: [groupId], references: [id])
  membershipId String? @db.VarChar(24)
  membership   GroupMembership? @relation("RefundMembership", fields: [membershipId], references: [id])

  // ASL TO'LOV — ixtiyoriy: qaytarim aniq bir tranzaksiyaga emas,
  // umumiy hisobga (depozit qoldig'iga) tegishli bo'lishi mumkin.
  originalTransactionId String? @db.VarChar(24)
  originalTransaction   PaymentTransaction? @relation("RefundOriginalTx", fields: [originalTransactionId], references: [id])
  paymentId String? @db.VarChar(24)
  payment   StudentPayment? @relation("RefundPayment", fields: [paymentId], references: [id])

  amount Decimal @db.Decimal(18, 2)
  method PaymentMethod @default(cash)
  reason String @default("")

  status RefundStatus @default(pending)

  requestedById String @db.VarChar(24)
  requestedBy   User   @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  approvedById  String? @db.VarChar(24)
  approvedBy    User?   @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  executedAt    DateTime?
  decisionNote  String @default("")

  // Mavjud tasdiq oqimiga ulanish (limitdan oshgan qaytarim).
  approvalId String? @db.VarChar(24)
  approval   Approval? @relation("RefundApproval", fields: [approvalId], references: [id])

  // Bajarilganda yozilgan jurnal yozuvi — audit izi.
  journalEntryId String? @db.VarChar(24)
  receiptId String? @db.VarChar(24)
  receipt   StoredFile? @relation("RefundReceipt", fields: [receiptId], references: [id])
  note      String @default("")

  createdById String? @db.VarChar(24)
  createdBy   User?   @relation("RefundCreatedBy", fields: [createdById], references: [id])

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.VarChar(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, createdAt])
  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@index([originalTransactionId])
  @@map("refunds")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOLIYA: AUDIT IZI (Faza 14)
// ═══════════════════════════════════════════════════════════════════════════
//
// `ActivityLog` DAN NEGA ALOHIDA: u HTTP darajasidagi log — "kim qaysi
// endpoint'ga bordi". U so'rov TANASINI saqlaydi, lekin QIYMAT QANDAY
// O'ZGARGANINI bilmaydi: 4.5 mln → 3.8 mln o'zgarishida eski qiymat
// hech qayerda qolmasdi. Moliyada esa asosiy savol aynan shu —
// "oldin qancha edi va kim o'zgartirdi?".
//
// Ikkinchi farq: ActivityLog TTL bilan tozalanadi (jobs/ttlCleanup),
// moliyaviy audit esa TOZALANMAYDI.
//
// APPEND-ONLY: `updatedAt` ATAYLAB YO'Q. Audit yozuvini tahrirlash
// mumkin bo'lsa, u audit bo'lishdan to'xtaydi.

model FinancialAuditLog {
  id String @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)

  // Qaysi hujjat: "Expense" | "Refund" | "Budget" | "Discount" |
  // "JournalEntry" | "RecurringExpense" | "Account" ...
  // FK EMAS — ataylab: hujjat o'chirilsa ham audit izi QOLISHI kerak.
  entityType String
  entityId   String @db.VarChar(24)
  action     FinancialAuditAction

  branchId String? @db.VarChar(24)
  branch   Branch? @relation("FinAuditBranch", fields: [branchId], references: [id])

  actorId String? @db.VarChar(24)
  actor   User?   @relation("FinAuditActor", fields: [actorId], references: [id])
  // Ism NUSXASI: foydalanuvchi keyin o'chirilsa ham "kim qilgani" qoladi.
  actorLabel String @default("")

  oldValue Json?
  newValue Json?
  changedFields String[] @default([])
  reason String @default("")

  // Eng ko'p so'raladigan ikki raqam ALOHIDA ustunda: "4.5 mln → 3.8 mln"
  // ni ko'rsatish uchun har safar JSON ochish shart bo'lmasin va ular
  // bo'yicha filtr/saralash ishlasin.
  amountBefore Decimal? @db.Decimal(18, 2)
  amountAfter  Decimal? @db.Decimal(18, 2)

  // Infratuzilma buni allaqachon qo'llab-quvvatlaydi (ActivityLog'da bor).
  ip        String @default("")
  userAgent String @default("")

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([branchId, createdAt])
  @@index([action, createdAt])
  @@map("financial_audit_logs")
}
