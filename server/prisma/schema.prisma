// ─────────────────────── FOYDALANUVCHI VA HUQUQ ───────────────────────

model User {
  id         String    @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  firstName  String
  lastName   String
  // Autentifikatsiya kaliti — YAGONA unique maydon.
  username   String    @unique
  // DIQQAT: telefon UNIQUE EMAS — bitta raqamdan bir nechta odam (aka-uka,
  // ota-ona) foydalanadi. Mongo'dagi eski `phone_1` unique indeksi ataylab
  // ko'chirilmadi.
  phone      String?
  passwordHash String
  // Dinamik rol: Role.value ga ishora qiladi, lekin FK EMAS — tizim
  // rollari (owner/teacher/student) Role jadvalisiz ham ishlaydi.
  role       String    @default("student")

  homeBranchId String? @db.VarChar(24)
  homeBranch   Branch? @relation("UserHomeBranch", fields: [homeBranchId], references: [id])

  isActive    Boolean   @default(true)
  archivedAt  DateTime?
  lastLoginAt DateTime?
  birthDate   DateTime?
  gender      Gender?
  enrolledAt  DateTime?

  leadId String? @db.VarChar(24)
  lead   Lead?   @relation("UserFromLead", fields: [leadId], references: [id])

  completedAt       DateTime?
  completedAtManual Boolean   @default(false)
  hiredAt           DateTime?
  payrollStartFrom  DateTime?
  terminatedAt      DateTime?
  terminationReason String    @default("")

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.VarChar(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchAssignments UserBranchAssignment[]

  // ── teskari bog'lanishlar ──
  activityLogs            ActivityLog[]            @relation("ActivityLogUser")
  aiConfigsUpdated        AiConfig[]               @relation("AiConfigUpdatedBy")
  approvalsRequested      Approval[]               @relation("ApprovalRequestedBy")
  approvalsDecided        Approval[]               @relation("ApprovalDecidedBy")
  archiveLogs             ArchiveLog[]             @relation("ArchiveLogUser")
  archiveLogsPerformed    ArchiveLog[]             @relation("ArchiveLogPerformedBy")
  archiveReasonsCreated   ArchiveReason[]          @relation("ArchiveReasonCreatedBy")
  assignmentsSent         Assignment[]             @relation("AssignmentSender")
  assignmentRecipients    AssignmentRecipient[]    @relation("AssignmentRecipientStudent")
  attendances             Attendance[]             @relation("AttendanceStudent")
  attendancesRecorded     Attendance[]             @relation("AttendanceRecordedBy")
  exemptions              AttendanceExemption[]    @relation("ExemptionStudent")
  exemptionsCreated       AttendanceExemption[]    @relation("ExemptionCreatedBy")
  botUsers                BotUser[]                @relation("BotUserUser")
  cashTransfersSent       CashTransfer[]           @relation("CashTransferSentBy")
  cashTransfersReceived   CashTransfer[]           @relation("CashTransferReceivedBy")
  coursesCreated          Course[]                 @relation("CourseCreatedBy")
  coursePricesCreated     CoursePrice[]            @relation("CoursePriceCreatedBy")
  debtWriteOffs           DebtWriteOff[]           @relation("DebtWriteOffStudent")
  debtWriteOffsCreated    DebtWriteOff[]           @relation("DebtWriteOffCreatedBy")
  depositTransactions     DepositTransaction[]     @relation("DepositTxStudent")
  depositTxCreated        DepositTransaction[]     @relation("DepositTxCreatedBy")
  discounts               Discount[]               @relation("DiscountStudent")
  discountsCreated        Discount[]               @relation("DiscountCreatedBy")
  expensesCreated         Expense[]                @relation("ExpenseCreatedBy")
  expenseCategoriesCreated ExpenseCategory[]       @relation("ExpenseCategoryCreatedBy")
  feedbacksAuthored       Feedback[]               @relation("FeedbackAuthor")
  feedbacksReplied        Feedback[]               @relation("FeedbackRepliedBy")
  feedbacksReviewed       Feedback[]               @relation("FeedbackReviewedBy")
  feedbacksResolved       Feedback[]               @relation("FeedbackResolvedBy")
  grades                  Grade[]                  @relation("GradeStudent")
  gradesRecorded          Grade[]                  @relation("GradeRecordedBy")
  teachingGroups          Group[]                  @relation("GroupTeachers")
  groupFeesCreated        GroupFee[]               @relation("GroupFeeCreatedBy")
  groupFeesUpdated        GroupFee[]               @relation("GroupFeeUpdatedBy")
  memberships             GroupMembership[]        @relation("MembershipStudent")
  holidaysCreated         Holiday[]                @relation("HolidayCreatedBy")
  importJobs              ImportJob[]              @relation("ImportJobUser")
  insightsAcknowledged    Insight[]                @relation("InsightAcknowledgedBy")
  journalEntriesCreated   JournalEntry[]           @relation("JournalEntryCreatedBy")
  kpiRulesCreated         KpiRule[]                @relation("KpiRuleCreatedBy")
  kpiRulesUpdated         KpiRule[]                @relation("KpiRuleUpdatedBy")
  leadsAssigned           Lead[]                   @relation("LeadAssignedTo")
  leadsAsStudent          Lead[]                   @relation("LeadStudent")
  leadsCredited           Lead[]                   @relation("LeadCreditedTo")
  leadsConverted          Lead[]                   @relation("LeadConvertedBy")
  leadsCreated            Lead[]                   @relation("LeadCreatedBy")
  leadOptionsCreated      LeadOption[]             @relation("LeadOptionCreatedBy")
  leadRoutingRules        LeadRoutingRule[]        @relation("LeadRoutingAssignee")
  cancellationsCreated    LessonCancellation[]     @relation("CancellationCreatedBy")
  notificationsSent       Notification[]           @relation("NotificationSender")
  notificationAudience    Notification[]           @relation("NotificationAudienceUsers")
  notificationRecipients  NotificationRecipient[]  @relation("NotificationRecipientUser")
  openingBalance          OpeningBalance?          @relation("OpeningBalanceUser")
  openingBalancesCreated  OpeningBalance[]         @relation("OpeningBalanceCreatedBy")
  paymentTransactions     PaymentTransaction[]     @relation("PaymentTxStudent")
  paymentTxCreated        PaymentTransaction[]     @relation("PaymentTxCreatedBy")
  payrollAuditLogs        PayrollAuditLog[]        @relation("PayrollAuditEmployee")
  payrollAuditActions     PayrollAuditLog[]        @relation("PayrollAuditActor")
  refreshTokens           RefreshToken[]           @relation("RefreshTokenUser")
  rolesFrozen             Role[]                   @relation("RoleFrozenBy")
  salaryTransactions      SalaryTransaction[]      @relation("SalaryTxTeacher")
  salaryTxCreated         SalaryTransaction[]      @relation("SalaryTxCreatedBy")
  shiftsAsCashier         Shift[]                  @relation("ShiftCashier")
  shiftsOpened            Shift[]                  @relation("ShiftOpenedBy")
  shiftsClosed            Shift[]                  @relation("ShiftClosedBy")
  staffCompensations      StaffCompensation[]      @relation("StaffCompEmployee")
  staffCompCreated        StaffCompensation[]      @relation("StaffCompCreatedBy")
  staffCompUpdated        StaffCompensation[]      @relation("StaffCompUpdatedBy")
  kpiAssignments          StaffKpiAssignment[]     @relation("KpiAssignmentEmployee")
  kpiAssignmentsCreated   StaffKpiAssignment[]     @relation("KpiAssignmentCreatedBy")
  staffPayrolls           StaffPayroll[]           @relation("StaffPayrollEmployee")
  staffPayrollsFinalized  StaffPayroll[]           @relation("StaffPayrollFinalizedBy")
  payrollAdjustments      StaffPayrollAdjustment[] @relation("AdjustmentEmployee")
  payrollAdjCreated       StaffPayrollAdjustment[] @relation("AdjustmentCreatedBy")
  payrollItems            StaffPayrollItem[]       @relation("PayrollItemEmployee")
  staffSalaryTransactions StaffSalaryTransaction[] @relation("StaffSalaryTxEmployee")
  staffSalaryTxCreated    StaffSalaryTransaction[] @relation("StaffSalaryTxCreatedBy")
  filesUploaded           StoredFile[]             @relation("StoredFileUploadedBy")
  deposit                 StudentDeposit?          @relation("StudentDepositStudent")
  freezes                 StudentFreeze[]          @relation("FreezeStudent")
  freezesCreated          StudentFreeze[]          @relation("FreezeCreatedBy")
  freezesEnded            StudentFreeze[]          @relation("FreezeEndedBy")
  studentPayments         StudentPayment[]         @relation("StudentPaymentStudent")
  teacherAbsences         TeacherAbsence[]         @relation("TeacherAbsenceTeacher")
  teacherAbsencesRecorded TeacherAbsence[]         @relation("TeacherAbsenceRecordedBy")
  teacherAttendances      TeacherAttendance[]      @relation("TeacherAttendanceTeacher")
  teacherAttRecorded      TeacherAttendance[]      @relation("TeacherAttendanceRecordedBy")
  teacherCompensations    TeacherCompensation[]    @relation("TeacherCompTeacher")
  teacherCompCreated      TeacherCompensation[]    @relation("TeacherCompCreatedBy")
  teacherCompUpdated      TeacherCompensation[]    @relation("TeacherCompUpdatedBy")
  groupPeriods            TeacherGroupPeriod[]     @relation("GroupPeriodTeacher")
  groupPeriodsCreated     TeacherGroupPeriod[]     @relation("GroupPeriodCreatedBy")
  groupPeriodsUpdated     TeacherGroupPeriod[]     @relation("GroupPeriodUpdatedBy")
  teacherSalaries         TeacherSalary[]          @relation("TeacherSalaryTeacher")
  teacherSalariesLocked   TeacherSalary[]          @relation("TeacherSalaryLockedBy")
  teacherSalariesCreated  TeacherSalary[]          @relation("TeacherSalaryCreatedBy")

  @@index([phone])
  @@index([leadId])
  @@index([homeBranchId, isDeleted, isActive])
  @@map("users")
}

// Mongo'da bu User ichidagi massiv edi (`branchAssignments`). Postgres'da
// alohida jadval — `branchAssignments.branchId` bo'yicha qidiruv kodda
// 8+ joyda ishlatiladi (branchContext.helper.js, branches.service.js).
model UserBranchAssignment {
  id       String  @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  userId   String  @db.VarChar(24)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String  @db.VarChar(24)
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role     String?

  @@unique([userId, branchId])
  @@index([branchId])
  @@map("user_branch_assignments")
}

model Role {
  id           String   @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  value        String   @unique
  label        String
  description  String   @default("")
  permissions  Permission[] @relation("RolePermissions")
  isSystem     Boolean  @default(false)
  roleType     RoleType @default(staff)
  defaultPath  String   @default("/owner")
  isFrozen     Boolean  @default(false)
  frozenAt     DateTime?
  frozenById   String?  @db.VarChar(24)
  frozenBy     User?    @relation("RoleFrozenBy", fields: [frozenById], references: [id])
  frozenReason String   @default("")
  permissionsVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  key         String  @unique
  label       String
  group       String  @default("general")
  module      String
  action      String
  moduleLabel String?
  moduleOrder Int     @default(100)
  roles       Role[]  @relation("RolePermissions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  userId    String    @db.VarChar(24)
  user      User      @relation("RefreshTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  // Mongo'da TTL indeks edi. Endi ttlCleanup.job.js tozalaydi.
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────── FILIAL ───────────────────────────

model Branch {
  id                      String    @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  name                    String
  code                    String?
  address                 String?
  phone                   String?
  isMain                  Boolean   @default(false)
  expenseApprovalThreshold Float?
  // Mongo'da Map<kind, {mode,maxAmount,minAmount,maxPercent}> edi.
  // Tuzilma constants/delegation.js dagi validateDelegation() bilan
  // tekshiriladi — u yagona haqiqat manbai bo'lib qoladi.
  delegation              Json?
  areaM2                  Float?
  openedAt                DateTime?
  isActive                Boolean   @default(true)
  archivedAt              DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.VarChar(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeUsers            User[]                   @relation("UserHomeBranch")
  assignments          UserBranchAssignment[]
  accounts             Account[]                @relation("AccountBranch")
  counterpartyAccounts Account[]                @relation("AccountCounterparty")
  aiConfig             AiConfig?                @relation("AiConfigBranch")
  aiRankings           AiRanking[]              @relation("AiRankingBranch")
  aiReports            AiReport[]               @relation("AiReportBranch")
  aiRuns               AiRun[]                  @relation("AiRunBranch")
  aiUsageLogs          AiUsageLog[]             @relation("AiUsageBranch")
  approvals            Approval[]               @relation("ApprovalBranch")
  assignmentPosts      Assignment[]             @relation("AssignmentBranch")
  cashTransfersFrom    CashTransfer[]           @relation("TransferFrom")
  cashTransfersTo      CashTransfer[]           @relation("TransferTo")
  coursePrices         CoursePrice[]            @relation("CoursePriceBranch")
  depositTransactions  DepositTransaction[]     @relation("DepositTxBranch")
  expenses             Expense[]                @relation("ExpenseBranch")
  expenseCategories    ExpenseCategory[]        @relation("ExpenseCategoryBranch")
  groups               Group[]                  @relation("GroupBranch")
  importJobs           ImportJob[]              @relation("ImportJobBranch")
  insights             Insight[]                @relation("InsightBranch")
  journalEntries       JournalEntry[]           @relation("JournalBranch")
  journalCounterparty  JournalEntry[]           @relation("JournalCounterparty")
  kpiRules             KpiRule[]                @relation("KpiRuleBranch")
  leads                Lead[]                   @relation("LeadBranch")
  leadRoutingRules     LeadRoutingRule[]        @relation("LeadRoutingBranch")
  openingBalances      OpeningBalance[]         @relation("OpeningBalanceBranch")
  paymentTransactions  PaymentTransaction[]     @relation("PaymentTxBranch")
  rooms                Room[]                   @relation("RoomBranch")
  salaryTransactions   SalaryTransaction[]      @relation("SalaryTxBranch")
  shifts               Shift[]                  @relation("ShiftBranch")
  staffCompensations   StaffCompensation[]      @relation("StaffCompBranch")
  staffPayrolls        StaffPayroll[]           @relation("StaffPayrollBranch")
  payrollAdjustments   StaffPayrollAdjustment[] @relation("AdjustmentBranch")
  staffSalaryTx        StaffSalaryTransaction[] @relation("StaffSalaryTxBranch")
  studentPayments      StudentPayment[]         @relation("StudentPaymentBranch")
  teacherCompensations TeacherCompensation[]    @relation("TeacherCompBranch")
  teacherSalaries      TeacherSalary[]          @relation("TeacherSalaryBranch")

  @@map("branches")
}

// ─────────────────────── O'QUV TUZILMASI ───────────────────────

model Course {
  id                    String  @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  title                 String
  code                  String  @unique
  level                 String  @default("")
  defaultDurationMonths Int?
  leadDirectionId       String? @db.VarChar(24)
  leadDirection         LeadOption? @relation("CourseLeadDirection", fields: [leadDirectionId], references: [id])
  isActive              Boolean @default(true)
  createdById           String? @db.VarChar(24)
  createdBy             User?   @relation("CourseCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups Group[]       @relation("GroupCourse")
  prices CoursePrice[] @relation("CoursePriceCourse")

  @@index([leadDirectionId])
  @@index([isActive, title])
  @@map("courses")
}

model CoursePrice {
  id        String    @id @default(dbgenerated("gen_object_id()")) @db.VarChar(24)
  courseId  String    @db.VarChar(24)
  course    Course    @relation("CoursePriceCourse", fields: [courseId], references: [id])
